# Copy to `.env` and fill in. Only `podman compose` reads this file; the backend
# outside a container reads server/.env instead.

# Signs session tokens. Must be 64 characters or longer or the server refuses to
# start. Generate one with:
#
#   openssl rand -hex 48
#
SECRET_KEY_BASE=

# Where `make run` listens (compose.yaml). 8080 by default.
# GLEAMDRILL_PORT=8090
