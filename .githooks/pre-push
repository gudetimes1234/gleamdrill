#!/bin/sh
# Refuse to push a stale dist/.
#
# deploy/web.Dockerfile copies dist/ verbatim rather than building it, so
# whatever is in the commit is what the site serves. CI checks the same thing,
# but Railway deploys from main on push without waiting for CI: by the time the
# red run lands, the stale bundle is already live.
#
# The build is a few seconds warm. GLEAMDRILL_SKIP_BUILD=1 skips it.
set -e

if [ -n "$GLEAMDRILL_SKIP_BUILD" ]; then
  echo "pre-push: GLEAMDRILL_SKIP_BUILD set, not building."
  exit 0
fi

root=$(git rev-parse --show-toplevel)
cd "$root"

echo "pre-push: make build"
if ! out=$(make build 2>&1); then
  echo "$out"
  echo
  echo "pre-push: the build failed. Push refused."
  exit 1
fi

# The app bundle and the worker bundles `make build` minifies into assets/.
if ! git diff --quiet -- dist assets; then
  git diff --stat -- dist assets
  echo
  echo "pre-push: the build changed committed output, so this commit would ship"
  echo "a stale app. Fold it in and push again:"
  echo
  echo "    git add dist assets && git commit --amend --no-edit"
  echo
  echo "(or commit it separately; GLEAMDRILL_SKIP_BUILD=1 git push to skip this)"
  exit 1
fi
