# The front door. Serves the built app and proxies the API, so the browser only
# ever talks to one origin: no CORS preflight, and no backend URL baked into the
# artifact. See `apiBase()` in src/algodrill/ffi.mjs, which falls back to
# `location.origin` precisely because of this.
#
# Both knobs are env-driven so one file covers every deployment:
#   PORT          the platform's port (Railway injects it)
#   API_UPSTREAM  where the backend lives: `api:8080` under compose,
#                 `api.railway.internal:8080` on Railway

{
	admin off
	# Railway and every other platform here terminate TLS at their edge.
	auto_https off
}

:{$PORT:8080} {
	encode zstd gzip

	# The two paths the backend owns. Everything else is static.
	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:8080}
	}

	handle /health {
		reverse_proxy {$API_UPSTREAM:api:8080}
	}

	handle {
		root * /srv

		# Cheap headers only. A real Content-Security-Policy is deliberately
		# absent: the Gleam compiler is wasm (needs wasm-unsafe-eval) and
		# Brython evaluates the Python it is handed, so a policy tight enough
		# to be worth having takes its own pass and its own testing.
		header {
			Referrer-Policy "strict-origin-when-cross-origin"
			X-Content-Type-Options "nosniff"
			# The app is never meant to be framed; drills are typed into it.
			Content-Security-Policy "frame-ancestors 'none'"
			-Server
		}

		# The runtime directories are version-stamped (assets/gleam-runtime/1.18.1,
		# assets/python-runtime/3.14.3), so a given URL can never change contents.
		@versioned path /gleam-runtime/* /python-runtime/*
		header @versioned Cache-Control "public, max-age=31536000, immutable"

		# The shell must never be cached: it is how a new bundle is discovered.
		# `/` has to be matched explicitly as well as `/index.html` -- header
		# matchers see the request path, and `try_files` rewrites to the shell
		# only afterwards, so a bare `/` (which is how everyone actually
		# arrives) missed this rule entirely.
		@shell path / /index.html
		header @shell Cache-Control "no-cache"

		# `{path}.html` reproduces the `cleanUrls` Vercel used to provide; the
		# final fallback is the SPA shell.
		try_files {path} {path}.html /index.html
		file_server
	}
}
