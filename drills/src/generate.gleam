//// Emits ../src/algodrill/problems/embedded.gleam: one function per drill returning
//// the solution source plus its Check (signature, starter stub, test harness), all
//// derived from the real, compilable modules in src/ and harnesses/.
////
//// Run from drills/: `gleam run -m generate`

import gleam/int
import gleam/io
import gleam/list
import gleam/string
import simplifile

const out_path = "../src/algodrill/problems/embedded.gleam"

pub fn main() {
  let assert Ok(entries) = simplifile.read_directory("harnesses")
  let assert Ok(sources) = simplifile.read_directory("src")
  let modules =
    entries
    |> list.filter(string.ends_with(_, ".gleam"))
    |> list.map(string.drop_end(_, string.length(".gleam")))
    |> list.sort(string.compare)

  let header =
    "//// GENERATED by `gleam run -m generate` in drills/ — do not edit.\n"
    <> "//// Source of truth: drills/src/*.gleam and drills/harnesses/*.gleam.\n\n"
    <> "import algodrill/problem.{type Check, Check}\n\n"
    <> "pub type Embedded {\n  Embedded(solutions: List(#(String, String)), check: Check)\n}\n"

  let functions = list.map(modules, drill_function(_, sources))
  let assert Ok(Nil) =
    simplifile.write(out_path, string.join([header, ..functions], "\n"))

  io.println(
    "embedded.gleam: "
    <> int.to_string(list.length(modules))
    <> " drills -> "
    <> out_path,
  )
}

fn drill_function(module: String, sources: List(String)) -> String {
  let assert Ok(primary) = simplifile.read("src/" <> module <> ".gleam")
  let assert Ok(harness) = simplifile.read("harnesses/" <> module <> ".gleam")
  let harness = string.trim_end(harness)

  let surface = public_surface(string.trim_end(primary))
  let assert True = list.any(surface, is_function)

  let solutions =
    [#("Solution 1", string.trim_end(primary)), ..alternates(module, sources)]
    |> list.map(fn(entry) {
      "      #(\"" <> escape(entry.0) <> "\", \"" <> escape(entry.1) <> "\"),\n"
    })
    |> string.concat

  "pub fn "
  <> module
  <> "() -> Embedded {\n  Embedded(\n    solutions: [\n"
  <> solutions
  <> "    ],\n    check: Check(\n      signature: \""
  <> escape(signature(surface))
  <> "\",\n      starter: \""
  <> escape(starter(surface))
  <> "\",\n      harness: \""
  <> escape(harness)
  <> "\",\n    ),\n  )\n}\n"
}

/// Alternate approaches live next to the primary as `<module>__<variant>.gleam`
/// and become "Solution 2 · Variant name" buttons. Every alternate must pass
/// the same harness (enforced by the round-trip suite).
fn alternates(
  module: String,
  sources: List(String),
) -> List(#(String, String)) {
  sources
  |> list.filter(string.starts_with(_, module <> "__"))
  |> list.filter(string.ends_with(_, ".gleam"))
  |> list.sort(string.compare)
  |> list.index_map(fn(file, index) {
    let assert Ok(code) = simplifile.read("src/" <> file)
    let variant =
      file
      |> string.drop_start(string.length(module <> "__"))
      |> string.drop_end(string.length(".gleam"))
      |> string.replace("_", " ")
      |> string.capitalise
    #(
      "Solution " <> int.to_string(index + 2) <> " \u{b7} " <> variant,
      string.trim_end(code),
    )
  })
}

/// The public surface a solver must reproduce: `pub type` blocks verbatim, and
/// `pub fn` headers with the body stripped. Headers can span lines, so the scan
/// balances parentheses (types balance braces) — safe here because none of the
/// drill sources put brace or paren characters inside string literals in headers
/// or type definitions.
type Item {
  TypeItem(text: String)
  FnItem(text: String)
}

fn is_function(item: Item) -> Bool {
  case item {
    FnItem(_) -> True
    TypeItem(_) -> False
  }
}

fn public_surface(source: String) -> List(Item) {
  collect(string.split(source, "\n"), [])
}

fn collect(lines: List(String), acc: List(Item)) -> List(Item) {
  case lines {
    [] -> list.reverse(acc)
    [line, ..rest] ->
      case
        string.starts_with(line, "pub type "),
        string.starts_with(line, "pub fn ")
      {
        True, _ -> {
          let #(block, remaining) = balanced(lines, [], 0, "{", "}")
          collect(remaining, [TypeItem(block), ..acc])
        }
        _, True -> {
          let #(block, remaining) = balanced(lines, [], 0, "(", ")")
          collect(remaining, [FnItem(strip_body_opener(block)), ..acc])
        }
        False, False -> collect(rest, acc)
      }
  }
}

/// Consumes lines until the open/close delimiters balance out. For functions the
/// balance point is the header's closing paren, whose line also carries the ` {`
/// that opens the body.
fn balanced(
  lines: List(String),
  acc: List(String),
  depth: Int,
  open: String,
  close: String,
) -> #(String, List(String)) {
  case lines {
    [] -> #(done(acc), [])
    [line, ..rest] -> {
      let depth = depth + occurrences(line, open) - occurrences(line, close)
      let acc = [line, ..acc]
      case depth <= 0 {
        True -> #(done(acc), rest)
        False -> balanced(rest, acc, depth, open, close)
      }
    }
  }
}

fn done(acc: List(String)) -> String {
  acc |> list.reverse |> string.join("\n")
}

fn occurrences(line: String, needle: String) -> Int {
  list.length(string.split(line, needle)) - 1
}

fn strip_body_opener(header: String) -> String {
  let trimmed = string.trim_end(header)
  case string.ends_with(trimmed, "{") {
    True -> trimmed |> string.drop_end(1) |> string.trim_end
    False -> trimmed
  }
}

fn signature(surface: List(Item)) -> String {
  surface
  |> list.map(fn(item) {
    case item {
      TypeItem(text) -> text
      FnItem(text) -> text
    }
  })
  |> string.join("\n\n")
}

fn starter(surface: List(Item)) -> String {
  surface
  |> list.map(fn(item) {
    case item {
      TypeItem(text) -> text
      FnItem(text) -> text <> " {\n  todo\n}"
    }
  })
  |> string.join("\n\n")
}

fn escape(source: String) -> String {
  source
  |> string.replace("\\", "\\\\")
  |> string.replace("\"", "\\\"")
}
