/// Ruby surface: the `require` lines, every top-level `def` header, and
/// every `class` with its method headers. The starter gives each method a
/// body that raises NotImplementedError, so a stub loads and fails. Assumes
/// one-line `def` headers and no endless (`def x = ...`) methods in a
/// solution, which holds for every drill source.
fn ruby_surface(source: String) -> #(String, String) {
  let lines = string.split(source, "\n")
  let requires =
    list.filter(lines, fn(line) { string.starts_with(line, "require ") })
  let items = ruby_items(lines, [])
  let sig =
    items
    |> list.map(fn(item) {
      case item {
        #("", [header]) -> header
        #(class, headers) -> string.join([class, ..headers], "\n") <> "\nend"
      }
    })
    |> string.join("\n\n")
  let unwritten = "raise NotImplementedError, \"todo\""
  let stubs =
    list.map(items, fn(item) {
      case item {
        #("", [header]) -> header <> "\n  " <> unwritten <> "\nend"
        #(class, headers) ->
          class
          <> "\n"
          <> headers
          |> list.map(fn(header) {
            header <> "\n    " <> unwritten <> "\n  end"
          })
          |> string.join("\n\n")
          <> "\nend"
      }
    })
  let stub =
    [string.join(requires, "\n"), ..stubs]
    |> list.filter(fn(block) { block != "" })
    |> string.join("\n\n")
  #(sig, stub)
}

/// `#("", [def])` for a top-level method, `#(class line, method headers)`
/// for a class.
fn ruby_items(
  lines: List(String),
  acc: List(#(String, List(String))),
) -> List(#(String, List(String))) {
  case lines {
    [] -> list.reverse(acc)
    [line, ..rest] ->
      case
        string.starts_with(line, "def "),
        string.starts_with(line, "class ")
      {
        True, _ -> ruby_items(rest, [#("", [line]), ..acc])
        _, True -> {
          let #(methods, remaining) = ruby_methods(rest, [])
          ruby_items(remaining, [#(line, methods), ..acc])
        }
        False, False -> ruby_items(rest, acc)
      }
  }
}

/// The `  def ...` headers of a class body, up to its unindented `end`.
fn ruby_methods(
  lines: List(String),
  acc: List(String),
) -> #(List(String), List(String)) {
  case lines {
    [] -> #(list.reverse(acc), [])
    ["end", ..rest] -> #(list.reverse(acc), rest)
    [line, ..rest] ->
      case string.starts_with(line, "  def ") {
        True -> ruby_methods(rest, [line, ..acc])
        False -> ruby_methods(rest, acc)
      }
  }
}

/// Haskell surface: the module's imports, every top-level `name :: ...`
/// signature, and every data/type/newtype line. The signature block shows
/// only the types; the starter repeats the imports (a drill knows which
/// containers it is about) and stubs each signed name with `error "todo"`,
/// which inhabits any type, so the stub compiles.
fn haskell_surface(source: String) -> #(String, String) {
  let lines = string.split(source, "\n")
  let imports =
    list.filter(lines, fn(line) { string.starts_with(line, "import ") })
  let signatures =
    list.filter(lines, fn(line) {
      string.contains(line, " :: ")
      && !string.starts_with(line, " ")
      && !string.starts_with(line, "--")
    })
  let declarations =
    list.filter(lines, fn(line) {
      string.starts_with(line, "data ")
      || string.starts_with(line, "type ")
      || string.starts_with(line, "newtype ")
    })

  let sig = string.join(list.append(declarations, signatures), "\n")
  let stubs =
    list.map(signatures, fn(line) {
      let name = case string.split_once(line, " ::") {
        Ok(#(name, _)) -> name
        Error(Nil) -> line
      }
      line <> "\n" <> name <> " = error \"todo\""
    })
  let stub =
    [
      "module Solution where",
      string.join(imports, "\n"),
      string.join(list.append(declarations, stubs), "\n\n"),
    ]
    |> list.filter(fn(block) { block != "" })
    |> string.join("\n\n")
  #(sig, stub)
}

