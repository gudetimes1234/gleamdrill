/// Go surface: every top-level `func` header (plain functions and methods)
/// and every `type` declaration. A struct's fields are the design, so both
/// the signature and the starter elide them; the starter adds a todo body to
/// each function and to each struct, which a solution has to declare
/// itself. `package main` is included because the attempt is compiled as a
/// file of that package.
fn go_surface(source: String) -> #(String, String) {
  let items = go_items(string.split(source, "\n"), [])
  let sig = string.join(items, "\n\n")
  let stub =
    items
    |> list.map(fn(header) {
      case
        string.starts_with(header, "func "),
        string.ends_with(header, "struct { … }")
      {
        True, _ -> header <> " {\n\tpanic(\"todo\")\n}"
        _, True ->
          string.drop_end(header, string.length("{ … }")) <> "{\n\t// todo\n}"
        False, False -> header
      }
    })
    |> string.join("\n\n")
  #(sig, "package main\n\n" <> stub)
}

/// One header per item: a `func` line without its brace, a struct as
/// `type Name struct { … }` (its body skipped through the closing brace),
/// any other `type` line as written.
fn go_items(lines: List(String), acc: List(String)) -> List(String) {
  case lines {
    [] -> list.reverse(acc)
    [line, ..rest] ->
      case
        string.starts_with(line, "func "),
        string.starts_with(line, "type ") && string.ends_with(line, "{")
      {
        True, _ -> go_items(rest, [strip_brace(line), ..acc])
        _, True -> {
          let remaining =
            rest |> list.drop_while(fn(l) { l != "}" }) |> list.drop(1)
          go_items(remaining, [strip_brace(line) <> " { … }", ..acc])
        }
        False, False ->
          case string.starts_with(line, "type ") {
            True -> go_items(rest, [line, ..acc])
            False -> go_items(rest, acc)
          }
      }
  }
}

/// `{ "<stem>": { "signature": ..., "starter": ... }, ... }`
fn elixir_surfaces() -> Dict(String, #(String, String)) {
  let assert Ok(raw) = simplifile.read("elixir/surface.json")
    as "drills/elixir/surface.json is missing: run `elixir surface.exs` in drills/elixir"
  let entry = {
    use signature <- decode.field("signature", decode.string)
    use starter <- decode.field("starter", decode.string)
    decode.success(#(signature, starter))
  }
  let assert Ok(surfaces) = json.parse(raw, decode.dict(decode.string, entry))
  surfaces
}

/// elixir/verify_all.exs — compiles each solution and evaluates its harness,
/// which is a script whose value is the list of {label, expected, actual}
/// triples. Every variant defines the same `Solution` module, so recompiling
/// over the previous one is the point rather than a mistake.
fn generate_elixir_verifier(rows: List(#(String, String, String))) -> Nil {
  let table =
    rows
    |> list.map(fn(row) {
      let #(module, label, stem) = row
      "  {\""
      <> escape(module)
      <> "\", \""
      <> escape(label)
      <> "\", \""
      <> escape(stem)
      <> "\"},\n"
    })
    |> string.concat

  let source =
    "# GENERATED by `gleam run -m generate` in drills/ - do not edit.\n"
    <> "# Runs every Elixir solution variant against its harness:\n"
    <> "#   elixir verify_all.exs     (from drills/elixir)\n"
    <> "Code.put_compiler_option(:ignore_module_conflict, true)\n\n"
    <> "variants = [\n"
    <> table
    <> "]\n\n"
    <> "root = Path.dirname(__ENV__.file)\n\n"
    <> "failures =\n"
    <> "  Enum.flat_map(variants, fn {module, label, stem} ->\n"
    <> "    solution = File.read!(Path.join([root, \"solutions\", stem <> \".exs\"]))\n"
    <> "    harness = File.read!(Path.join([root, \"harnesses\", module <> \".exs\"]))\n\n"
    <> "    try do\n"
    <> "      Code.compile_string(solution, stem <> \".exs\")\n"
    <> "      {cases, _bindings} = Code.eval_string(harness, [], file: module <> \".exs\")\n\n"
    <> "      case cases do\n"
    <> "        [] ->\n"
    <> "          [\"#{module} [#{label}] harness produced no cases\"]\n\n"
    <> "        cases ->\n"
    <> "          for {name, expected, actual} <- cases, expected != actual do\n"
    <> "            \"#{module} [#{label}] #{name}: expected #{expected}, got #{actual}\"\n"
    <> "          end\n"
    <> "      end\n"
    <> "    rescue\n"
    <> "      error -> [\"#{module} [#{label}] raised #{Exception.message(error)}\"]\n"
    <> "    end\n"
    <> "  end)\n\n"
    <> "Enum.each(failures, fn failure -> IO.puts(\"FAIL \" <> failure) end)\n"
    <> "IO.puts(\"#{length(variants)} Elixir variants checked, #{length(failures)} failures\")\n"
    <> "if failures != [], do: System.halt(1)\n"

  let assert Ok(Nil) = simplifile.write("elixir/verify_all.exs", source)
  io.println(
    "verify_all.exs: " <> int.to_string(list.length(rows)) <> " Elixir variants",
  )
}

fn generate_typescript() {
  let assert Ok(entries) = simplifile.read_directory("ts/harnesses")
  let assert Ok(sources) = simplifile.read_directory("ts/solutions")
  let modules = module_names(entries, ".ts")

  let header =
    "//// GENERATED by `gleam run -m generate` in drills/ — do not edit.\n"
    <> "//// Source of truth: drills/ts/solutions/*.ts and drills/ts/harnesses/*.ts.\n\n"
    <> "import gleamdrill/content/problem.{Check}\n"
    <> "import gleamdrill/content/problems/generated/embedded.{type Embedded, Embedded}\n"

  let functions =
    list.map(modules, fn(module) {
      let sources = variant_sources(module, sources, "ts/solutions/", ".ts")
      let assert Ok(harness) =
        simplifile.read("ts/harnesses/" <> module <> ".ts")
      let assert Ok(primary) =
        simplifile.read("ts/solutions/" <> module <> ".ts")
      let #(sig, stub) = typescript_surface(primary)
      drill_function(module, sources, sig, stub, string.trim_end(harness))
    })

  let assert Ok(Nil) =
    simplifile.write(
      "../src/gleamdrill/content/problems/generated/embedded_ts.gleam",
      string.join(
        [
          header,
          ..list.append(functions, [by_stem_function(modules, "Embedded")])
        ],
        "\n",
      ),
    )
  io.println(
    "embedded_ts.gleam: " <> int.to_string(list.length(modules)) <> " drills",
  )

  generate_ts_verifier(variant_rows(modules, sources, ".ts"))
}

/// ts/verify_all.ts plus the ts/.verify scratch tree it imports.
///
/// A harness does `import * as solution from "./solution"`, so it only runs with
/// a sibling module of that name — hence one directory per variant. The harness
/// is copied in; the solution is a one-line re-export shim, so the real file
/// under ts/solutions stays the only copy of the code.
fn generate_ts_verifier(rows: List(#(String, String, String))) -> Nil {
  // Wipe first: a renamed or deleted variant must not linger and keep passing.
  let _ = simplifile.delete("ts/.verify")

  list.each(rows, fn(row) {
    let #(module, _label, stem) = row
    let directory = "ts/.verify/" <> stem
    let assert Ok(Nil) = simplifile.create_directory_all(directory)
    let assert Ok(Nil) =
      simplifile.write(
        directory <> "/solution.ts",
        "export * from \"../../solutions/" <> stem <> "\";\n",
      )
    let assert Ok(harness) = simplifile.read("ts/harnesses/" <> module <> ".ts")
    let assert Ok(Nil) = simplifile.write(directory <> "/harness.ts", harness)
  })

  let imports =
    rows
    |> list.index_map(fn(row, index) {
      "import * as v"
      <> int.to_string(index)
      <> " from \"./.verify/"
      <> row.2
      <> "/harness\";\n"
    })
    |> string.concat

  let table =
    rows
    |> list.index_map(fn(row, index) {
      let #(module, label, _stem) = row
      "  [\""
      <> escape(module)
      <> "\", \""
      <> escape(label)
      <> "\", v"
      <> int.to_string(index)
      <> ".run],\n"
    })
    |> string.concat

  let source =
    "// GENERATED by `gleam run -m generate` in drills/ - do not edit.\n"
    <> "// Runs every TypeScript solution variant against its harness:\n"
    <> "//   bun verify_all.ts     (from drills/ts)\n"
    <> imports
    <> "\ntype Case = [string, string, string];\n\n"
    <> "const VARIANTS: [string, string, () => Case[]][] = [\n"
    <> table
    <> "];\n\n"
    <> "const failures: string[] = [];\n"
    <> "for (const [module, label, run] of VARIANTS) {\n"
    <> "  let cases: Case[];\n"
    <> "  try {\n"
    <> "    cases = run();\n"
    <> "  } catch (error) {\n"
    <> "    failures.push(`${module} [${label}] threw ${error}`);\n"
    <> "    continue;\n"
    <> "  }\n"
    <> "  if (cases.length === 0) {\n"
    <> "    failures.push(`${module} [${label}] harness produced no cases`);\n"
    <> "  }\n"
    <> "  for (const [name, expected, actual] of cases) {\n"
    <> "    if (expected !== actual) {\n"
    <> "      failures.push(`${module} [${label}] ${name}: expected ${expected}, got ${actual}`);\n"
    <> "    }\n"
    <> "  }\n"
    <> "}\n"
    <> "for (const failure of failures) console.log(\"FAIL \" + failure);\n"
    <> "console.log(`${VARIANTS.length} TypeScript variants checked, ${failures.length} failures`);\n"
    <> "if (failures.length > 0) process.exit(1);\n"

  let assert Ok(Nil) = simplifile.write("ts/verify_all.ts", source)
  io.println(
    "verify_all.ts: "
    <> int.to_string(list.length(rows))
    <> " TypeScript variants",
  )
}

/// TypeScript surface: `export function name(...): ret` headers, and
/// `export class Name` blocks with their method headers. Both are single-line
/// in every drill source. Starter bodies get a `// todo` comment.
fn typescript_surface(source: String) -> #(String, String) {
  let items = typescript_items(string.split(source, "\n"), [])
  let sig =
    items
    |> list.map(fn(item) { string.join(item, "\n") })
    |> string.join("\n\n")
  let stub =
    items
    |> list.map(fn(item) {
      case item {
        // A class: header, one stubbed method per header, closing brace. The
        // method lines already carry their two-space indentation.
        [class_header, first_method, ..rest] ->
          [
            class_header <> " {",
            ..list.map([first_method, ..rest], fn(method) {
              method <> " {\n    // todo\n  }"
            })
          ]
          |> string.join("\n")
          |> string.append("\n}")
        [header] -> header <> " {\n  // todo\n}"
        [] -> ""
      }
    })
    |> string.join("\n\n")
  #(sig, stub)
}

/// One entry per exported item: a single-element list for a function, or the
/// class header followed by its method headers.
fn typescript_items(
  lines: List(String),
  acc: List(List(String)),
) -> List(List(String)) {
  case lines {
    [] -> list.reverse(acc)
    [line, ..rest] ->
      case
        string.starts_with(line, "export function "),
        string.starts_with(line, "export class ")
      {
        True, _ -> typescript_items(rest, [[strip_brace(line)], ..acc])
        _, True -> {
          let #(methods, remaining) = typescript_methods(rest, [])
          typescript_items(remaining, [[strip_brace(line), ..methods], ..acc])
        }
        False, False -> typescript_items(rest, acc)
      }
  }
}

/// A class body's method headers: the lines indented by exactly two spaces that
/// open a block. Fields do not open one, and statements inside a method body
/// are indented further, so the two tests together are enough.
fn typescript_methods(
  lines: List(String),
  acc: List(String),
) -> #(List(String), List(String)) {
  case lines {
    [] -> #(list.reverse(acc), [])
    [line, ..rest] ->
      case line == "" || string.starts_with(line, " ") {
        False -> #(list.reverse(acc), lines)
        True ->
          case
            string.starts_with(line, "  ")
            && !string.starts_with(line, "   ")
            && string.ends_with(string.trim_end(line), "{")
          {
            // Kept indented: the signature shows the class as written.
            True -> typescript_methods(rest, [strip_brace(line), ..acc])
            False -> typescript_methods(rest, acc)
          }
      }
  }
}

fn strip_brace(line: String) -> String {
  let trimmed = string.trim_end(line)
  case string.ends_with(trimmed, "{") {
    True -> trimmed |> string.drop_end(1) |> string.trim_end
    False -> trimmed
  }
}

const approaches_out_path = "../src/gleamdrill/content/problems/generated/approaches.gleam"

/// The approach hint ladders: drills/approaches/<slug>.txt, sections split by
/// `== nudge` / `== walk` / `== pseudocode`, emitted as a generated module
/// keyed by title slug. MANIFEST (slug<TAB>title per line) is the census: a
/// catalog title with no ladder file fails the build here, not in the app.
fn generate_approaches() {
  let assert Ok(manifest) = simplifile.read("approaches/MANIFEST")
  let entries =
    manifest
    |> string.trim
    |> string.split("\n")
    |> list.map(fn(line) {
      let assert [slug, _title] = string.split(line, "\t")
      slug
    })

  let missing =
    list.filter(entries, fn(slug) {
      simplifile.read("approaches/" <> slug <> ".txt")
      == Error(simplifile.Enoent)
    })
  case missing {
    [] -> Nil
    _ -> {
      io.println("MISSING approach ladders: " <> string.join(missing, ", "))
      panic as "every MANIFEST title needs drills/approaches/<slug>.txt"
    }
  }

  let arms =
    entries
    |> list.filter(fn(slug) {
      simplifile.read("approaches/" <> slug <> ".txt")
      != Error(simplifile.Enoent)
    })
    |> list.map(fn(slug) {
      let assert Ok(text) = simplifile.read("approaches/" <> slug <> ".txt")
      "    \""
      <> slug
      <> "\" -> [\n"
      <> approach_stages(slug, text)
      <> "    ]\n"
    })
    |> string.concat

  let source =
    "//// GENERATED by `gleam run -m generate` in drills/ — do not edit.\n"
    <> "//// Source of truth: drills/approaches/*.txt (see MANIFEST).\n\n"
    <> "import gleamdrill/content/problem.{\n  type ApproachStage, Nudge, Pseudocode, Walk, WalkStep,\n}\n"
    <> "import gleam/list\n"
    <> "import gleam/string\n\n"
    <> "/// The hint ladder for a problem title, vaguest stage first. Titles\n"
    <> "/// are slugged so every language mirror of a problem shares one ladder.\n"
    <> "pub fn for_title(title: String) -> List(ApproachStage) {\n"
    <> "  case slug(title) {\n"
    <> arms
    <> "    _ -> []\n  }\n}\n\n"
    <> "fn slug(title: String) -> String {\n"
    <> "  title\n"
    <> "  |> string.lowercase\n"
    <> "  |> string.to_graphemes\n"
    <> "  |> list.map(fn(g) {\n"
    <> "    case string.contains(\"abcdefghijklmnopqrstuvwxyz0123456789\", g) {\n"
    <> "      True -> g\n"
    <> "      False -> \"-\"\n"
    <> "    }\n"
    <> "  })\n"
    <> "  |> string.join(\"\")\n"
    <> "  |> collapse_dashes\n"
    <> "}\n\n"
    <> "fn collapse_dashes(text: String) -> String {\n"
    <> "  let squeezed = string.replace(text, \"--\", \"-\")\n"
    <> "  case squeezed == text {\n"
    <> "    True -> trim_dashes(text)\n"
    <> "    False -> collapse_dashes(squeezed)\n"
    <> "  }\n"
    <> "}\n\n"
    <> "fn trim_dashes(text: String) -> String {\n"
    <> "  let text = case string.starts_with(text, \"-\") {\n"
    <> "    True -> string.drop_start(text, 1)\n"
    <> "    False -> text\n"
    <> "  }\n"
    <> "  case string.ends_with(text, \"-\") {\n"
    <> "    True -> string.drop_end(text, 1)\n"
    <> "    False -> text\n"
    <> "  }\n"
    <> "}\n\n"
  let assert Ok(Nil) = simplifile.write(approaches_out_path, source)
  io.println(
    "approaches.gleam: "
    <> int.to_string(list.length(entries))
    <> " hint ladders -> "
    <> approaches_out_path,
  )
  approach_census(entries)
}

/// The language slugs a code slice may be written for, matching
/// `problem.language_slug`. Hardcoded because drills/ is its own project and
/// does not depend on the app package; an unknown slug fails the build, so a
/// typo cannot quietly become a slice nothing will ever read.
const code_languages: List(String) = [
  "python", "gleam", "typescript", "elixir", "go", "haskell", "ruby",
]

/// Per-language coverage of the code slices, printed after the ladders are
/// emitted.
///
/// A report, never a gate. The prose of a plan is shared and complete; the
/// code is being written one language at a time, and a language with no slice
/// falls back to the shared one, so a gap is a thing still to do rather than
/// a broken tree. `make content` fails on a *malformed* file and on nothing
/// else.
fn approach_census(slugs: List(String)) {
  let files =
    list.filter_map(slugs, fn(slug) {
      simplifile.read("approaches/" <> slug <> ".txt")
    })
  let steps =
    list.fold(files, 0, fn(total, text) {
      total + count_lines(text, fn(line) { string.starts_with(line, "# ") })
    })
  io.println(
    "approaches: "
    <> int.to_string(list.length(files))
    <> " ladders, "
    <> int.to_string(steps)
    <> " steps",
  )
  use language <- list.each(["", ..code_languages])
  let opener = case language {
    "" -> "code:"
    _ -> "code." <> language <> ":"
  }
  let section = case language {
    "" -> "== pseudocode"
    _ -> "== pseudocode." <> language
  }
  let sliced =
    list.fold(files, 0, fn(total, text) {
      total + count_lines(text, fn(line) { line == opener })
    })
  let whole =
    list.count(files, fn(text) {
      count_lines(text, fn(line) { line == section }) > 0
    })
  io.println(
    "  "
    <> string.pad_end(
      case language {
        "" -> "shared"
        _ -> language
      },
      11,
      " ",
    )
    <> string.pad_start(int.to_string(sliced), 5, " ")
    <> " of "
    <> int.to_string(steps)
    <> " steps"
    <> string.pad_start(int.to_string(whole), 6, " ")
    <> " of "
    <> int.to_string(list.length(files))
    <> " whole",
  )
}

fn count_lines(text: String, matches: fn(String) -> Bool) -> Int {
  text |> string.split("\n") |> list.count(fn(line) { matches(line) })
}

/// Parses one ladder file into emitted Gleam constructors, asserting the
/// format: >=2 sections, nudge first, and every `pseudocode` section in the
/// trailing run. A `== walk` body is `# step` blocks (see `walk_steps`).
///
/// The last rung may be written once per language -- `== pseudocode`,
/// `== pseudocode.go`, `== pseudocode.elixir` -- and those collapse into a
/// single `Pseudocode` carrying all of them, keyed by language slug. Bare
/// `== pseudocode` is the fallback under the empty-string key.
fn approach_stages(slug: String, text: String) -> String {
  let sections =
    { "\n" <> string.trim(text) }
    |> string.split("\n== ")
    |> list.filter(fn(part) { string.trim(part) != "" })
    |> list.map(fn(part) {
      let assert [header, ..body] = string.split(part, "\n")
      #(string.trim(header), string.join(body, "\n") |> string.trim)
    })

  let assert True = list.length(sections) >= 2
  let assert Ok(#(first_kind, _)) = list.first(sections)
  let assert "nudge" = first_kind

  // Once a pseudocode section appears, every section after it must be one
  // too: they become a single rung, and a walk sandwiched between two of
  // them would silently change the ladder's order.
  let #(leading, trailing) =
    list.split_while(sections, fn(section) { !is_pseudocode(section.0) })
  case list.all(trailing, fn(section) { is_pseudocode(section.0) }) {
    True -> Nil
    False -> {
      io.println("a section follows the pseudocode in " <> slug)
      panic as "every pseudocode section must be at the end of the ladder"
    }
  }

  let front =
    leading
    |> list.map(fn(section) {
      let #(kind, body) = section
      case kind {
        "nudge" -> "      Nudge(\"" <> escape(body) <> "\"),\n"
        "walk" -> "      Walk([\n" <> walk_steps(slug, body) <> "      ]),\n"
        _ -> {
          io.println("unknown section '" <> kind <> "' in " <> slug)
          panic as "approach section must be nudge, walk or pseudocode"
        }
      }
    })
    |> string.concat

  let back = case trailing {
    [] -> ""
    _ -> {
      let slices =
        list.map(trailing, fn(section) {
          #(section_language(slug, section.0), section.1)
        })
      "      Pseudocode(" <> slices_literal(slug, slices) <> "),\n"
    }
  }

  front <> back
}

fn is_pseudocode(kind: String) -> Bool {
  kind == "pseudocode" || string.starts_with(kind, "pseudocode.")
}

/// `pseudocode` is the shared fallback; `pseudocode.go` is Go's own.
fn section_language(slug: String, kind: String) -> String {
  case kind {
    "pseudocode" -> ""
    _ -> known_language(slug, string.drop_start(kind, 11))
  }
}

fn known_language(slug: String, language: String) -> String {
  case list.contains(code_languages, language) {
    True -> language
    False -> {
      io.println("unknown language '" <> language <> "' in " <> slug)
      panic as "a code slice must name a language the catalogue has"
    }
  }
}

/// `[#("", "..."), #("go", "...")]`, refusing a language written twice.
fn slices_literal(slug: String, slices: List(#(String, String))) -> String {
  let languages = list.map(slices, fn(entry) { entry.0 })
  case list.length(list.unique(languages)) == list.length(languages) {
    True -> Nil
    False -> {
      io.println("a language has two code slices in " <> slug)
      panic as "each language may write one slice per step"
    }
  }
  case list.filter(slices, fn(entry) { entry.1 == "" }) {
    [] -> Nil
    _ -> {
      io.println("an empty code slice in " <> slug)
      panic as "a code slice with nothing under it is not written yet"
    }
  }
  "["
  <> {
    slices
    |> list.map(fn(entry) {
      "#(\"" <> entry.0 <> "\", \"" <> escape(entry.1) <> "\")"
    })
    |> string.join(", ")
  }
  <> "]"
}

/// A `== walk` body: blocks starting `# <step>`, each with a `hint:` line, a
/// `why:` line and any number of code slices. A missing or blank hint or why
/// fails the build: a walkthrough step that cannot explain itself is not
/// written yet.
///
/// A slice opens with a line that is exactly `code:` (the shared fallback) or
/// `code.<language>:`, and runs to the next such line or the end of the block.
/// `hint:` and `why:` therefore have to come before the first slice, which is
/// the convention every existing file already follows.
fn walk_steps(slug: String, body: String) -> String {
  let blocks =
    { "\n" <> string.trim(body) }
    |> string.split("\n# ")
    |> list.filter(fn(part) { string.trim(part) != "" })
  let assert True = blocks != []
  blocks
  |> list.map(fn(block) {
    let assert [step, ..rest] = string.split(block, "\n")
    let step = string.trim(step)
    let #(hint, why, _open, slices) =
      list.fold(rest, #("", "", False, []), fn(acc, line) {
        let #(hint, why, open, slices) = acc
        case code_opener(slug, line), open {
          Ok(language), _ -> #(hint, why, True, [#(language, []), ..slices])
          // Once a slice has opened, every other line belongs to it.
          Error(Nil), True -> {
            let assert [#(language, lines), ..rest] = slices
            #(hint, why, open, [#(language, [line, ..lines]), ..rest])
          }
          Error(Nil), False ->
            case
              string.starts_with(line, "hint:"),
              string.starts_with(line, "why:")
            {
              True, _ -> #(
                string.trim(string.drop_start(line, 5)),
                why,
                open,
                slices,
              )
              _, True -> #(
                hint,
                string.trim(string.drop_start(line, 4)),
                open,
                slices,
              )
              _, _ -> {
                io.println(
                  "stray line in walk step of " <> slug <> ": " <> line,
                )
                panic as "walk step lines are `# step`, `hint:`, `why:` or `code[.lang]:`"
              }
            }
        }
      })
    let slices =
      slices
      |> list.reverse
      |> list.map(fn(entry) {
        #(entry.0, entry.1 |> list.reverse |> string.join("\n") |> string.trim)
      })
    case step == "" || hint == "" || why == "" {
      True -> {
        io.println(
          "walk step without step, hint or why in " <> slug <> ": " <> step,
        )
        panic as "every walk step needs a step, a hint and a why"
      }
      False -> Nil
    }
    "        WalkStep(\n          step: \""
    <> escape(step)
    <> "\",\n          hint: \""
    <> escape(hint)
    <> "\",\n          why: \""
    <> escape(why)
    <> "\",\n          code: "
    <> slices_literal(slug, slices)
    <> ",\n        ),\n"
  })
  |> string.concat
}

/// A line that opens a code slice, and which language it is for. `code:` is
/// the shared fallback; `code.go:` is Go's own.
fn code_opener(slug: String, line: String) -> Result(String, Nil) {
  case line == "code:" {
    True -> Ok("")
    False ->
      case string.starts_with(line, "code.") && string.ends_with(line, ":") {
        False -> Error(Nil)
        True ->
          Ok(known_language(
            slug,
            line |> string.drop_start(5) |> string.drop_end(1),
          ))
      }
  }
}

fn generate_gleam() {
  let assert Ok(entries) = simplifile.read_directory("harnesses")
  let assert Ok(sources) = simplifile.read_directory("src")
  let modules = module_names(entries, ".gleam")

  let header =
    "//// GENERATED by `gleam run -m generate` in drills/ — do not edit.\n"
    <> "//// Source of truth: drills/src/*.gleam and drills/harnesses/*.gleam.\n\n"
    <> "import gleamdrill/content/problem.{type Check, Check}\n\n"
    <> "pub type Embedded {\n  Embedded(solutions: List(#(String, String, String, String)), check: Check)\n}\n"

  let functions =
    list.map(modules, fn(module) {
      let sources = variant_sources(module, sources, "src/", ".gleam")
      let assert Ok(harness) =
        simplifile.read("harnesses/" <> module <> ".gleam")
      // The signature and starter always come from the bare-stem primary,
      // which ordering may have moved away from the head of the list.
      let assert Ok(primary) = simplifile.read("src/" <> module <> ".gleam")
      let surface = public_surface(primary)
      let assert True = list.any(surface, is_function)
      drill_function(
        module,
        sources,
        signature(surface),
        starter(surface),
        string.trim_end(harness),
      )
    })

  let assert Ok(Nil) =
    simplifile.write(
      out_path,
      string.join(
        [
          header,
          ..list.append(functions, [by_stem_function(modules, "Embedded")])
        ],
        "\n",
      ),
    )
  io.println(
    "embedded.gleam: "
    <> int.to_string(list.length(modules))
    <> " drills -> "
    <> out_path,
  )
}

fn generate_python() {
  let assert Ok(entries) = simplifile.read_directory("python/harnesses")
  let assert Ok(sources) = simplifile.read_directory("python/solutions")
  let modules = module_names(entries, ".py")

  let header =
    "//// GENERATED by `gleam run -m generate` in drills/ — do not edit.\n"
    <> "//// Source of truth: drills/python/solutions/*.py and drills/python/harnesses/*.py.\n\n"
    <> "import gleamdrill/content/problem.{Check}\n"
    <> "import gleamdrill/content/problems/generated/embedded.{type Embedded, Embedded}\n"

  let functions =
    list.map(modules, fn(module) {
      let sources = variant_sources(module, sources, "python/solutions/", ".py")
      let assert Ok(harness) =
        simplifile.read("python/harnesses/" <> module <> ".py")
      let assert Ok(primary) =
        simplifile.read("python/solutions/" <> module <> ".py")
      let #(sig, stub) = python_surface(strip_line_tags(primary, ".py"))
      drill_function(module, sources, sig, stub, string.trim_end(harness))
    })

  let assert Ok(Nil) =
    simplifile.write(
      python_out_path,
      string.join(
        [
          header,
          ..list.append(functions, [by_stem_function(modules, "Embedded")])
        ],
        "\n",
      ),
    )
  io.println(
    "embedded_python.gleam: "
    <> int.to_string(list.length(modules))
    <> " drills -> "
    <> python_out_path,
  )

  generate_python_verifier(variant_rows(modules, sources, ".py"))
}

/// python/verify_all.py — execs each solution then its harness in one fresh
/// namespace (the harnesses reference bare names, so sharing a dict is all it
/// takes) and compares the repr pairs the harness collects.
fn generate_python_verifier(rows: List(#(String, String, String))) -> Nil {
  let table =
    rows
    |> list.map(fn(row) {
      let #(module, label, stem) = row
      "    (\""
      <> escape(module)
      <> "\", \""
      <> escape(label)
      <> "\", \""
      <> escape(stem)
      <> "\"),\n"
    })
    |> string.concat

  let source =
    "# GENERATED by `gleam run -m generate` in drills/ - do not edit.\n"
    <> "# Runs every Python solution variant against its harness:\n"
    <> "#   python3 verify_all.py     (from drills/python)\n"
    <> "import os\n"
    <> "import sys\n\n"
    <> "VARIANTS = [\n"
    <> table
    <> "]\n\n"
    <> "def main():\n"
    <> "    root = os.path.dirname(os.path.abspath(__file__))\n"
    <> "    failures = []\n"
    <> "    for module, label, stem in VARIANTS:\n"
    <> "        with open(os.path.join(root, \"solutions\", stem + \".py\")) as handle:\n"
    <> "            solution = handle.read()\n"
    <> "        with open(os.path.join(root, \"harnesses\", module + \".py\")) as handle:\n"
    <> "            harness = handle.read()\n"
    <> "        namespace = {}\n"
    <> "        try:\n"
    <> "            exec(compile(solution, stem + \".py\", \"exec\"), namespace)\n"
    <> "            exec(compile(harness, module + \".py\", \"exec\"), namespace)\n"
    <> "        except Exception as error:\n"
    <> "            failures.append(\"%s [%s] raised %s: %s\" % (module, label, type(error).__name__, error))\n"
    <> "            continue\n"
    <> "        results = namespace.get(\"__results__\", [])\n"
    <> "        if not results:\n"
    <> "            failures.append(\"%s [%s] harness produced no cases\" % (module, label))\n"
    <> "        for case, expected, actual in results:\n"
    <> "            if expected != actual:\n"
    <> "                failures.append(\"%s [%s] %s: expected %s, got %s\" % (module, label, case, expected, actual))\n"
    <> "    for failure in failures:\n"
    <> "        print(\"FAIL \" + failure)\n"
    <> "    print(\"%d Python variants checked, %d failures\" % (len(VARIANTS), len(failures)))\n"
    <> "    sys.exit(1 if failures else 0)\n\n"
    <> "main()\n"

  let assert Ok(Nil) = simplifile.write("python/verify_all.py", source)
  io.println(
    "verify_all.py: " <> int.to_string(list.length(rows)) <> " Python variants",
  )
}

/// The `case` that lets the hand-written catalogue address a drill by its file
/// stem. Generated rather than written, because Gleam has no reflection: this
/// is the only way a string becomes a call, and at 150 problems it is not a
/// thing anyone should be maintaining by hand.
fn by_stem_function(modules: List(String), returns: String) -> String {
  let arms =
    modules
    |> list.map(fn(module) {
      "    \"" <> module <> "\" -> Ok(" <> module <> "())\n"
    })
    |> string.concat

  "pub fn by_stem(stem: String) -> Result("
  <> returns
  <> ", Nil) {\n  case stem {\n"
  <> arms
  <> "    _ -> Error(Nil)\n  }\n}\n"
}

fn module_names(entries: List(String), extension: String) -> List(String) {
  entries
  |> list.filter(string.ends_with(_, extension))
  |> list.map(string.drop_end(_, string.length(extension)))
  |> list.sort(string.compare)
}

fn drill_function(
  module: String,
  sources: List(#(String, String, String, String)),
  sig: String,
  stub: String,
  harness: String,
) -> String {
  let solutions =
    sources
    |> list.map(fn(entry) {
      "      #(\""
      <> escape(entry.0)
      <> "\", \""
      <> escape(entry.1)
      <> "\", \""
      <> escape(entry.2)
      <> "\", \""
      <> escape(entry.3)
      <> "\"),\n"
    })
    |> string.concat

  "pub fn "
  <> module
  <> "() -> Embedded {\n  Embedded(\n    solutions: [\n"
  <> solutions
  <> "    ],\n    check: Check(\n      signature: \""
  <> escape(sig)
  <> "\",\n      starter: \""
  <> escape(stub)
  <> "\",\n      harness: \""
  <> escape(harness)
  <> "\",\n      graded: True,\n    ),\n  )\n}\n"
}

/// A variant unordered sorts after every ordered one; among the unordered the
/// primary stays first and alternates keep filename order, which reproduces
/// the old numbering exactly for content that has not been annotated yet.
const default_order = 999

/// What a note's directive lines declare about a variant. `kind` names the
/// technique and becomes the button label ("Brute Force", "Hash Map", "Nifty
/// Python"); `complexity` is the Big-O line shown beside it; `order` places
/// the variant worst-to-best. All optional: prose-only notes still work.
type Meta {
  Meta(
    kind: String,
    complexity: String,
    order: Int,
    note: String,
    /// The Line Drill pattern this variant is the canonical solution for
    /// (`@pattern two-pointers`), or "" when it is a reference solution only.
    pattern: String,
  )
}

/// The prose for one variant, keyed by its file stem so all four language
/// mirrors of a variant share a single write-up. Directive lines (`@kind`,
/// `@big-o`, `@order`) are metadata, stripped from the prose; a `@shared/<name>`
/// line resolves to notes/shared/<name>.txt — that one hop is the entire
/// mechanism for prose that repeats across problems. Missing file: no note.
/// A note is shared across languages by stem, on the assumption that the
/// same stem is the same algorithm everywhere. Where one language's file
/// genuinely is a different technique -- an LRU cache leaning on an
/// insertion-ordered dict has no honest Gleam, Elixir or Go twin -- a
/// `notes/<stem><ext>.txt` (`nc133_lru_cache.go.txt`) speaks for that
/// language alone and the shared note is not consulted.
fn note_meta(stem: String, extension: String) -> Meta {
  case simplifile.read("notes/" <> stem <> extension <> ".txt") {
    Ok(text) -> parse_note(text)
    Error(_) ->
      case simplifile.read("notes/" <> stem <> ".txt") {
        Error(_) ->
          Meta(
            kind: "",
            complexity: "",
            order: default_order,
            note: "",
            pattern: "",
          )
        Ok(text) -> parse_note(text)
      }
  }
}

fn parse_note(text: String) -> Meta {
  let #(directives, prose) =
    string.trim(text)
    |> string.split("\n")
    |> list.partition(fn(line) {
      string.starts_with(line, "@kind ")
      || string.starts_with(line, "@big-o ")
      || string.starts_with(line, "@order ")
      || string.starts_with(line, "@pattern ")
    })
  let value = fn(prefix: String) {
    directives
    |> list.find_map(fn(line) {
      case string.starts_with(line, prefix) {
        True -> Ok(string.trim(string.drop_start(line, string.length(prefix))))
        False -> Error(Nil)
      }
    })
    |> result.unwrap("")
  }
  Meta(
    kind: value("@kind "),
    complexity: value("@big-o "),
    order: value("@order ") |> int.parse |> result.unwrap(default_order),
    note: resolve_note(string.join(prose, "\n")),
    pattern: value("@pattern "),
  )
}

/// The primary plus any `<module>__<variant>` alternates, as
/// #(label, complexity, file stem), ordered worst-to-best by each note's
/// `@order` directive. This is the single definition of what counts as a
/// variant; the embedded modules and both verifiers all derive from it.
///
/// The label is the note's `@kind` when declared; otherwise the old scheme
/// ("Solution 1", "Solution N · Variant name") derived from the filename.
fn variant_entries(
  module: String,
  files: List(String),
  extension: String,
) -> List(#(String, String, String)) {
  let prefix = module <> "__"
  let alternates =
    files
    |> list.filter(string.starts_with(_, prefix))
    |> list.filter(string.ends_with(_, extension))
    |> list.sort(string.compare)
    |> list.map(string.drop_end(_, string.length(extension)))

  [module, ..alternates]
  |> list.map(fn(stem) { #(stem, note_meta(stem, extension)) })
  |> list.sort(fn(a, b) {
    let #(stem_a, meta_a) = a
    let #(stem_b, meta_b) = b
    case int.compare(meta_a.order, meta_b.order) {
      order.Eq ->
        // Unordered: primary first, then filename — the old presentation.
        case stem_a == module, stem_b == module {
          True, False -> order.Lt
          False, True -> order.Gt
          _, _ -> string.compare(stem_a, stem_b)
        }
      decided -> decided
    }
  })
  |> list.index_map(fn(entry, index) {
    let #(stem, meta) = entry
    let label = case meta.kind, stem == module {
      "", True -> "Solution " <> int.to_string(index + 1)
      "", False ->
        "Solution "
        <> int.to_string(index + 1)
        <> " \u{b7} "
        <> {
          stem
          |> string.drop_start(string.length(prefix))
          |> string.replace("_", " ")
          |> string.capitalise
        }
      kind, _ -> kind
    }
    #(label, meta.complexity, stem)
  })
}

/// Every variant as #(label, complexity, note, source). Alternates must pass
/// the same harness as the primary (enforced by `make verify`).
fn variant_sources(
  module: String,
  files: List(String),
  directory: String,
  extension: String,
) -> List(#(String, String, String, String)) {
  variant_entries(module, files, extension)
  |> list.map(fn(entry) {
    let #(label, complexity, stem) = entry
    let assert Ok(code) = simplifile.read(directory <> stem <> extension)
    // Line Drill tags (`# @3`) are authoring marks, never part of the code a
    // learner reads.
    let code = strip_line_tags(code, extension)
    #(label, complexity, note_meta(stem, extension).note, string.trim_end(code))
  })
}

/// Each `@shared/<name>` line expands in place to notes/shared/<name>.txt;
/// every other line is kept as written. The parts join as paragraphs, so a note
/// reads as "here is the technique" followed by "here is what this variant does
/// with it" — the technique sentence written once, the specific one per variant.
fn resolve_note(text: String) -> String {
  text
  |> string.split("\n")
  |> list.map(fn(line) {
    case string.starts_with(line, "@shared/") {
      False -> line
      True -> {
        let name = line |> string.drop_start(8) |> string.trim
        case simplifile.read("notes/shared/" <> name <> ".txt") {
          Ok(shared) -> string.trim(shared)
          Error(_) -> ""
        }
      }
    }
  })
  |> list.filter(fn(part) { part != "" })
  |> string.join("\n\n")
}

/// Flattens every module's variants into #(module, label, file stem) rows.
fn variant_rows(
  modules: List(String),
  files: List(String),
  extension: String,
) -> List(#(String, String, String)) {
  list.flat_map(modules, fn(module) {
    variant_entries(module, files, extension)
    |> list.map(fn(entry) { #(module, entry.0, entry.2) })
  })
}

/// Python surface: top-level `def name(...):` headers and `class Name:` blocks
/// with their method headers. Signature keeps the headers verbatim; the starter
/// fills each body with `pass`. Assumes single-line def headers, which holds
/// for every drill source.
fn python_surface(source: String) -> #(String, String) {
  let items = python_items(string.split(source, "\n"), [])
  let sig =
    items
    |> list.map(fn(item) { string.join(item, "\n") })
    |> string.join("\n\n")
  let stub =
    items
    |> list.map(fn(item) {
      item
      |> list.map(fn(line) {
        case string.starts_with(line, "    def ") {
          True -> line <> "\n        pass"
          False ->
            case string.starts_with(line, "def ") {
              True -> line <> "\n    pass"
              False -> line
            }
        }
      })
      |> string.join("\n")
    })
    |> string.join("\n\n")
  #(sig, stub)
}

fn python_items(
  lines: List(String),
  acc: List(List(String)),
) -> List(List(String)) {
  case lines {
    [] -> list.reverse(acc)
    [line, ..rest] ->
      case
        string.starts_with(line, "def "),
        string.starts_with(line, "class ")
      {
        True, _ -> python_items(rest, [[line], ..acc])
        _, True -> {
          let #(methods, remaining) = python_methods(rest, [])
          python_items(remaining, [[line, ..methods], ..acc])
        }
        False, False -> python_items(rest, acc)
      }
  }
}

/// Collects the `    def ...` headers of a class body; stops at the first
/// unindented line.
fn python_methods(
  lines: List(String),
  acc: List(String),
) -> #(List(String), List(String)) {
  case lines {
    [] -> #(list.reverse(acc), [])
    [line, ..rest] ->
      case
        line == ""
        || string.starts_with(line, "    ")
        || string.starts_with(line, "\t")
      {
        False -> #(list.reverse(acc), lines)
        True ->
          case string.starts_with(line, "    def ") {
            True -> python_methods(rest, [line, ..acc])
            False -> python_methods(rest, acc)
          }
      }
  }
}

/// The public surface a solver must reproduce: `pub type` blocks verbatim, and
/// `pub fn` headers with the body stripped. Headers can span lines, so the scan
/// balances parentheses (types balance braces) — safe here because none of the
/// drill sources put brace or paren characters inside string literals in headers
/// or type definitions.
type Item {
  TypeItem(text: String)
  FnItem(text: String)
}

fn is_function(item: Item) -> Bool {
  case item {
    FnItem(_) -> True
    TypeItem(_) -> False
  }
}

fn public_surface(source: String) -> List(Item) {
  collect(string.split(source, "\n"), [])
}

fn collect(lines: List(String), acc: List(Item)) -> List(Item) {
  case lines {
    [] -> list.reverse(acc)
    [line, ..rest] ->
      case
        string.starts_with(line, "pub type "),
        string.starts_with(line, "pub fn ")
      {
        True, _ -> {
          let #(block, remaining) = balanced(lines, [], 0, "{", "}")
          collect(remaining, [TypeItem(block), ..acc])
        }
        _, True -> {
          let #(block, remaining) = balanced(lines, [], 0, "(", ")")
          collect(remaining, [FnItem(strip_body_opener(block)), ..acc])
        }
        False, False -> collect(rest, acc)
      }
  }
}

/// Consumes lines until the open/close delimiters balance out. For functions the
/// balance point is the header's closing paren, whose line also carries the ` {`
/// that opens the body.
fn balanced(
  lines: List(String),
  acc: List(String),
  depth: Int,
  open: String,
  close: String,
) -> #(String, List(String)) {
  case lines {
    [] -> #(done(acc), [])
    [line, ..rest] -> {
      let depth = depth + occurrences(line, open) - occurrences(line, close)
      let acc = [line, ..acc]
      case depth <= 0 {
        True -> #(done(acc), rest)
        False -> balanced(rest, acc, depth, open, close)
      }
    }
  }
}

fn done(acc: List(String)) -> String {
  acc |> list.reverse |> string.join("\n")
}

fn occurrences(line: String, needle: String) -> Int {
  list.length(string.split(line, needle)) - 1
}

fn strip_body_opener(header: String) -> String {
  let trimmed = string.trim_end(header)
  case string.ends_with(trimmed, "{") {
    True -> trimmed |> string.drop_end(1) |> string.trim_end
    False -> trimmed
  }
}

fn signature(surface: List(Item)) -> String {
  surface
  |> list.map(fn(item) {
    case item {
      TypeItem(text) -> text
      FnItem(text) -> text
    }
  })
  |> string.join("\n\n")
}

fn starter(surface: List(Item)) -> String {
  surface
  |> list.map(fn(item) {
    case item {
      TypeItem(text) -> text
      FnItem(text) -> text <> " {\n  todo\n}"
    }
  })
  |> string.join("\n\n")
}

fn escape(source: String) -> String {
  source
  |> string.replace("\\", "\\\\")
  |> string.replace("\"", "\\\"")
}

// --- Line Drill patterns ----------------------------------------------------

const patterns_out_path = "../src/gleamdrill/content/problems/generated/patterns.gleam"

/// The languages whose solutions carry Line Drill tags, as
/// #(language slug, solutions directory, extension, line-comment marker).
/// A language joins this list once its pattern solutions exist; until then
/// its drills keep the old step rail, and its files are never checked for
/// tags.
const pattern_languages: List(#(String, String, String, String)) = [
  #("python", "python/solutions/", ".py", "#"),
]

/// One pseudocode line of a pattern: its number, the step it sits under, the
/// line itself (indentation kept), and the prose every language shares.
type PseudoLine {
  PseudoLine(id: Int, step: Int, text: String, hint: String, why: String)
}

type PatternDoc {
  PatternDoc(
    slug: String,
    complexity: String,
    nudge: String,
    steps: List(String),
    lines: List(PseudoLine),
  )
}

/// One line of a language solution, as Line Drill sees it.
type CodeLine {
  GivenLine(text: String)
  BlankLine(text: String, indent: Int, ids: List(Int))
}

/// drills/patterns/<stem>.txt -> generated/patterns.gleam.
///
/// A pattern file holds every pattern a problem can be solved with, each as
/// numbered pseudocode lines with a hint and a why. A language solution whose
/// note says `@pattern <slug>` is that pattern's canonical code in its
/// language, and tags each line that should be a blank with the pseudocode
/// lines it implements (`# @3`, `# @3,4`). Untagged lines are given; full-line
/// comments are dropped.
///
/// Every rule below fails the build rather than the app: a Line Drill that
/// cannot explain a line, or has a line nothing types, is not written yet.
fn generate_patterns() {
  let #(source, docs, arms_and_functions) = pattern_source([])
  let assert Ok(Nil) = simplifile.write(patterns_out_path, source)
  io.println(
    "patterns.gleam: "
    <> int.to_string(list.length(docs))
    <> " pattern files -> "
    <> patterns_out_path,
  )
  pattern_census(docs, arms_and_functions)
}

/// Every Line Drill check `make content` runs, writing nothing: the pattern
/// files parse, every tag lands, every claimed pattern is fully tagged. Run
/// as `gleam run -m check_patterns` in drills/; safe beside another run.
pub fn check_patterns(only: List(String)) {
  let #(_, docs, arms_and_functions) = pattern_source(only)
  pattern_census(docs, arms_and_functions)
  io.println("Line Drill content OK")
}

/// The patterns module's source, from every problem or only the stems in
/// `only` when it is not empty.
fn pattern_source(only: List(String)) {
  let wanted = fn(stem: String) {
    only == []
    || list.contains(only, case string.split_once(stem, "__") {
      Ok(#(module, _)) -> module
      Error(Nil) -> stem
    })
  }
  let vocab = pattern_vocab()
  let assert Ok(entries) = simplifile.read_directory("patterns")
  let stems =
    entries
    |> list.filter(string.ends_with(_, ".txt"))
    |> list.map(string.drop_end(_, 4))
    |> list.filter(wanted)
    |> list.sort(string.compare)
  let docs =
    list.map(stems, fn(stem) {
      let assert Ok(text) = simplifile.read("patterns/" <> stem <> ".txt")
      #(stem, parse_patterns(stem, text, vocab))
    })

  let arms_and_functions =
    list.flat_map(pattern_languages, fn(language) {
      let #(slug, directory, extension, marker) = language
      let assert Ok(files) = simplifile.read_directory(directory)
      let modules =
        files
        |> list.filter(string.ends_with(_, extension))
        |> list.map(string.drop_end(_, string.length(extension)))
        |> list.filter(fn(stem) { !string.contains(stem, "__") })
        |> list.filter(wanted)
      check_unclaimed_tags(
        list.filter(files, fn(file) {
          wanted(string.drop_end(file, string.length(extension)))
        }),
        directory,
        extension,
        marker,
      )
      list.filter_map(modules, fn(module) {
        let claims =
          variant_entries(module, files, extension)
          |> list.filter_map(fn(entry) {
            let stem = entry.2
            case note_meta(stem, extension).pattern {
              "" -> Error(Nil)
              pattern -> Ok(#(pattern, stem))
            }
          })
        case list.key_find(docs, module), claims {
          Error(Nil), [] -> Error(Nil)
          Error(Nil), [#(pattern, stem), ..] ->
            fail_patterns(
              stem,
              "claims @pattern "
                <> pattern
                <> " but drills/patterns/"
                <> module
                <> ".txt does not exist",
            )
          Ok(patterns), _ ->
            Ok(language_patterns(
              module,
              slug,
              patterns,
              claims,
              directory,
              extension,
              marker,
              vocab,
            ))
        }
      })
    })

  let arms =
    arms_and_functions
    |> list.map(fn(entry) {
      let #(module, language, function, _) = entry
      "    \""
      <> language
      <> "\", \""
      <> module
      <> "\" -> "
      <> function
      <> "()\n"
    })
    |> string.concat
  let functions =
    arms_and_functions
    |> list.map(fn(entry) { entry.3 })
    |> string.join("\n")

  let source =
    "//// GENERATED by `gleam run -m generate` in drills/ — do not edit.\n"
    <> "//// Source of truth: drills/patterns/*.txt and the `@pattern` solutions\n"
    <> "//// tagged under drills/<language>/solutions/.\n\n"
    <> "import gleamdrill/content/problem.{\n"
    <> "  type Pattern, Blank, Given, LineNote, Pattern,\n}\n\n"
    <> "/// Every pattern a drill can be line-drilled with in one language,\n"
    <> "/// primary (canonical) first. Empty: no Line Drill yet.\n"
    <> "pub fn for_stem(stem: String, language: String) -> List(Pattern) {\n"
    <> "  case language, stem {\n"
    <> arms
    <> "    _, _ -> []\n  }\n}\n\n"
    <> functions
  #(source, docs, arms_and_functions)
}

fn pattern_vocab() -> List(#(String, String)) {
  let assert Ok(text) = simplifile.read("patterns/VOCAB")
  text
  |> string.trim
  |> string.split("\n")
  |> list.map(fn(line) {
    case string.split(line, "\t") {
      [slug, name] -> #(slug, name)
      _ -> {
        io.println("bad VOCAB line: " <> line)
        panic as "patterns/VOCAB lines are slug<TAB>Display name"
      }
    }
  })
}

fn fail_patterns(where: String, problem: String) -> a {
  io.println("LINE DRILL: " <> where <> ": " <> problem)
  panic as "drills/patterns content is malformed (see the line above)"
}

/// Parses `== pattern <slug>` sections: `complexity:` and `nudge:` first,
/// then `-- step <title>` headers, each followed by numbered pseudocode lines
/// (`3 while left < right:`) and that line's indented `hint:` and `why:`.
fn parse_patterns(
  stem: String,
  text: String,
  vocab: List(#(String, String)),
) -> List(PatternDoc) {
  let sections =
    { "\n" <> string.trim(text) }
    |> string.split("\n== pattern ")
    |> list.filter(fn(part) { string.trim(part) != "" })
  case sections {
    [] -> fail_patterns(stem, "no `== pattern <slug>` section")
    _ -> Nil
  }
  let docs =
    list.map(sections, fn(section) {
      let assert [header, ..body] = string.split(section, "\n")
      let slug = string.trim(header)
      case list.key_find(vocab, slug) {
        Ok(_) -> Nil
        Error(Nil) ->
          fail_patterns(stem, "unknown pattern slug '" <> slug <> "'")
      }
      parse_pattern(stem <> " [" <> slug <> "]", slug, body)
    })
  let slugs = list.map(docs, fn(doc) { doc.slug })
  case list.length(list.unique(slugs)) == list.length(slugs) {
    True -> docs
    False -> fail_patterns(stem, "a pattern is written twice")
  }
}

fn parse_pattern(
  where: String,
  slug: String,
  body: List(String),
) -> PatternDoc {
  let empty = PatternDoc(slug:, complexity: "", nudge: "", steps: [], lines: [])
  let doc =
    list.fold(body, empty, fn(doc, line) {
      let trimmed = string.trim(line)
      case trimmed {
        "" -> doc
        _ ->
          case string.starts_with(line, "complexity:") {
            True ->
              PatternDoc(
                ..doc,
                complexity: string.trim(string.drop_start(line, 11)),
              )
            False ->
              case string.starts_with(line, "nudge:") {
                True ->
                  PatternDoc(
                    ..doc,
                    nudge: string.trim(string.drop_start(line, 6)),
                  )
                False -> pattern_body_line(where, doc, line, trimmed)
              }
          }
      }
    })
  let doc =
    PatternDoc(
      ..doc,
      steps: list.reverse(doc.steps),
      lines: list.reverse(doc.lines),
    )
  case doc.complexity == "" || doc.nudge == "" {
    True -> fail_patterns(where, "needs a `complexity:` and a `nudge:`")
    False -> Nil
  }
  case doc.lines {
    [] -> fail_patterns(where, "has no pseudocode lines")
    _ -> Nil
  }
  list.each(doc.lines, fn(line) {
    case line.hint == "" || line.why == "" {
      True ->
        fail_patterns(
          where,
          "line " <> int.to_string(line.id) <> " is missing its hint or why",
        )
      False -> Nil
    }
  })
  let ids = list.map(doc.lines, fn(line) { line.id })
  case
    list.index_map(ids, fn(id, index) { id == index + 1 })
    |> list.all(fn(ok) { ok })
  {
    True -> doc
    False -> fail_patterns(where, "lines must be numbered 1, 2, 3... in order")
  }
}

fn pattern_body_line(
  where: String,
  doc: PatternDoc,
  line: String,
  trimmed: String,
) -> PatternDoc {
  case string.starts_with(line, "-- step ") {
    True ->
      PatternDoc(..doc, steps: [
        string.trim(string.drop_start(line, 8)),
        ..doc.steps
      ])
    False ->
      case
        string.starts_with(trimmed, "hint:"),
        string.starts_with(trimmed, "why:"),
        doc.lines
      {
        True, _, [last, ..rest] ->
          PatternDoc(..doc, lines: [
            PseudoLine(..last, hint: string.trim(string.drop_start(trimmed, 5))),
            ..rest
          ])
        _, True, [last, ..rest] ->
          PatternDoc(..doc, lines: [
            PseudoLine(..last, why: string.trim(string.drop_start(trimmed, 4))),
            ..rest
          ])
        _, _, _ ->
          case string.split_once(line, " "), doc.steps {
            Ok(#(number, text)), [_, ..] ->
              case int.parse(number) {
                Ok(id) ->
                  PatternDoc(..doc, lines: [
                    PseudoLine(
                      id:,
                      step: list.length(doc.steps) - 1,
                      text: string.trim_end(text),
                      hint: "",
                      why: "",
                    ),
                    ..doc.lines
                  ])
                Error(Nil) -> fail_patterns(where, "stray line: " <> line)
              }
            _, [] ->
              fail_patterns(
                where,
                "a line comes before any `-- step`: " <> line,
              )
            _, _ -> fail_patterns(where, "stray line: " <> line)
          }
      }
  }
}

/// A file with tags but no `@pattern` is a half-finished port: the tags
/// would be stripped from the display and silently do nothing.
fn check_unclaimed_tags(
  files: List(String),
  directory: String,
  extension: String,
  marker: String,
) -> Nil {
  files
  |> list.filter(string.ends_with(_, extension))
  |> list.each(fn(file) {
    let stem = string.drop_end(file, string.length(extension))
    let assert Ok(source) = simplifile.read(directory <> file)
    let tagged =
      source
      |> string.split("\n")
      |> list.any(fn(line) { line_tag(line, marker) != Error(Nil) })
    case tagged, note_meta(stem, extension).pattern {
      True, "" ->
        fail_patterns(stem, "has `@N` tags but its note has no @pattern")
      _, _ -> Nil
    }
  })
}

/// One drill's patterns in one language: the emitted function's name, and
/// its source.
fn language_patterns(
  module: String,
  language: String,
  docs: List(PatternDoc),
  claims: List(#(String, String)),
  directory: String,
  extension: String,
  marker: String,
  vocab: List(#(String, String)),
) -> #(String, String, String, String) {
  let claimed = list.map(claims, fn(claim) { claim.0 })
  case list.length(list.unique(claimed)) == list.length(claimed) {
    True -> Nil
    False ->
      fail_patterns(
        module,
        "two " <> language <> " solutions claim one pattern",
      )
  }
  list.each(docs, fn(doc) {
    case list.contains(claimed, doc.slug) {
      True -> Nil
      False ->
        fail_patterns(
          module,
          "pattern "
            <> doc.slug
            <> " has no "
            <> language
            <> " solution claiming it",
        )
    }
  })
  // variant_entries orders worst-to-best, so the last claim is canonical.
  let ordered = list.reverse(claims)
  let patterns =
    list.map(ordered, fn(claim) {
      let #(slug, stem) = claim
      let assert Ok(doc) = list.find(docs, fn(doc) { doc.slug == slug })
      let assert Ok(source) = simplifile.read(directory <> stem <> extension)
      let lines = code_lines(stem, source, marker)
      check_tags(stem, doc, lines)
      let assert Ok(name) = list.key_find(vocab, slug)
      pattern_literal(doc, name, lines)
    })
  let function = module <> "__" <> language
  #(
    module,
    language,
    function,
    "fn "
      <> function
      <> "() -> List(Pattern) {\n  [\n"
      <> string.concat(patterns)
      <> "  ]\n}\n",
  )
}

/// A solution file as given and blank lines: full-line comments dropped, runs
/// of empty lines squeezed to one, and none at either end.
fn code_lines(stem: String, source: String, marker: String) -> List(CodeLine) {
  source
  |> string.split("\n")
  |> list.map(string.trim_end)
  |> list.filter(fn(line) {
    !string.starts_with(string.trim_start(line), marker)
  })
  |> list.map(fn(line) {
    case line_tag(line, marker) {
      Error(Nil) -> GivenLine(line)
      Ok(#(code, ids)) -> {
        let text = string.trim_start(code)
        case text, string.contains(text, "  " <> marker <> " ") {
          "", _ -> fail_patterns(stem, "a tag on an empty line")
          _, True ->
            fail_patterns(
              stem,
              "tagged line keeps a trailing comment, which the learner would have to type: "
                <> text
                <> " (move the comment onto its own line above)",
            )
          _, False ->
            BlankLine(
              text:,
              indent: string.length(code) - string.length(text),
              ids:,
            )
        }
      }
    }
  })
  |> squeeze_empty([])
}

fn squeeze_empty(lines: List(CodeLine), acc: List(CodeLine)) -> List(CodeLine) {
  case lines, acc {
    [], [GivenLine(""), ..rest] -> squeeze_empty([], rest)
    [], _ -> list.reverse(acc)
    [GivenLine(""), ..rest], [] -> squeeze_empty(rest, [])
    [GivenLine(""), ..rest], [GivenLine(""), ..] -> squeeze_empty(rest, acc)
    [line, ..rest], _ -> squeeze_empty(rest, [line, ..acc])
  }
}

/// `    total += x  # @6,7` -> Ok(#("    total += x", [6, 7])).
fn line_tag(line: String, marker: String) -> Result(#(String, List(Int)), Nil) {
  let opener = marker <> " @"
  case string.split(line, opener) |> list.reverse {
    [tag, before, ..earlier] -> {
      let code =
        [before, ..earlier]
        |> list.reverse
        |> string.join(opener)
        |> string.trim_end
      case
        string.trim(tag)
        |> string.split(",")
        |> list.try_map(fn(part) { int.parse(string.trim(part)) })
      {
        Ok(ids) if ids != [] -> Ok(#(code, ids))
        _ -> Error(Nil)
      }
    }
    _ -> Error(Nil)
  }
}

/// Removes every Line Drill tag from a source, for the copies a learner reads.
fn strip_line_tags(source: String, extension: String) -> String {
  case list.find(pattern_languages, fn(language) { language.2 == extension }) {
    Error(Nil) -> source
    Ok(#(_, _, _, marker)) ->
      source
      |> string.split("\n")
      |> list.map(fn(line) {
        case line_tag(line, marker) {
          Ok(#(code, _)) -> code
          Error(Nil) -> line
        }
      })
      |> string.join("\n")
  }
}

fn check_tags(stem: String, doc: PatternDoc, lines: List(CodeLine)) -> Nil {
  let tagged =
    list.flat_map(lines, fn(line) {
      case line {
        BlankLine(ids:, ..) -> ids
        GivenLine(_) -> []
      }
    })
  case tagged {
    [] ->
      fail_patterns(stem, "claims @pattern " <> doc.slug <> " but has no tags")
    _ -> Nil
  }
  let known = list.map(doc.lines, fn(line) { line.id })
  list.each(tagged, fn(id) {
    case list.contains(known, id) {
      True -> Nil
      False ->
        fail_patterns(
          stem,
          "tag @"
            <> int.to_string(id)
            <> " points at no line of pattern "
            <> doc.slug,
        )
    }
  })
  list.each(known, fn(id) {
    case list.contains(tagged, id) {
      True -> Nil
      False ->
        fail_patterns(
          stem,
          "pseudocode line "
            <> int.to_string(id)
            <> " of "
            <> doc.slug
            <> " is never tagged",
        )
    }
  })
}

fn pattern_literal(
  doc: PatternDoc,
  name: String,
  lines: List(CodeLine),
) -> String {
  let step_of = fn(ids: List(Int)) {
    let first = list.fold(ids, 999_999, int.min)
    list.find(doc.lines, fn(line) { line.id == first })
    |> result.map(fn(line) { line.step })
    |> result.unwrap(0)
  }
  let notes =
    doc.lines
    |> list.map(fn(line) {
      "        LineNote(id: "
      <> int.to_string(line.id)
      <> ", step: "
      <> int.to_string(line.step)
      <> ", pseudo: \""
      <> escape(line.text)
      <> "\", hint: \""
      <> escape(line.hint)
      <> "\", why: \""
      <> escape(line.why)
      <> "\"),\n"
    })
    |> string.concat
  let code =
    lines
    |> list.map(fn(line) {
      case line {
        GivenLine(text) -> "        Given(\"" <> escape(text) <> "\"),\n"
        BlankLine(text:, indent:, ids:) ->
          "        Blank(text: \""
          <> escape(text)
          <> "\", indent: "
          <> int.to_string(indent)
          <> ", step: "
          <> int.to_string(step_of(ids))
          <> ", ids: ["
          <> { ids |> list.map(int.to_string) |> string.join(", ") }
          <> "]),\n"
      }
    })
    |> string.concat
  let pseudocode =
    doc.lines
    |> list.map(fn(line) { line.text })
    |> string.join("\n")
  "    Pattern(\n      slug: \""
  <> doc.slug
  <> "\",\n      name: \""
  <> escape(name)
  <> "\",\n      complexity: \""
  <> escape(doc.complexity)
  <> "\",\n      nudge: \""
  <> escape(doc.nudge)
  <> "\",\n      steps: ["
  <> {
    doc.steps
    |> list.map(fn(step) { "\"" <> escape(step) <> "\"" })
    |> string.join(", ")
  }
  <> "],\n      notes: [\n"
  <> notes
  <> "      ],\n      pseudocode: \""
  <> escape(pseudocode)
  <> "\",\n      lines: [\n"
  <> code
  <> "      ],\n    ),\n"
}

/// Per-language Line Drill coverage, printed after the module is written. A
/// report, not a gate, for the same reason as the approach census: a drill
/// with no patterns yet keeps the old rail.
fn pattern_census(
  docs: List(#(String, List(PatternDoc))),
  emitted: List(#(String, String, String, String)),
) -> Nil {
  let pattern_count =
    list.fold(docs, 0, fn(total, entry) { total + list.length(entry.1) })
  let lines =
    list.fold(docs, 0, fn(total, entry) {
      list.fold(entry.1, total, fn(total, doc) {
        total + list.length(doc.lines)
      })
    })
  io.println(
    "patterns: "
    <> int.to_string(list.length(docs))
    <> " problems, "
    <> int.to_string(pattern_count)
    <> " patterns, "
    <> int.to_string(lines)
    <> " pseudocode lines",
  )
  list.each(pattern_languages, fn(language) {
    let #(slug, directory, extension, _) = language
    let assert Ok(files) = simplifile.read_directory(directory)
    let problems =
      files
      |> list.filter(fn(file) {
        string.starts_with(file, "nc")
        && string.ends_with(file, extension)
        && !string.contains(file, "__")
      })
      |> list.length
    let covered = list.count(emitted, fn(entry) { entry.1 == slug })
    io.println(
      "  "
      <> string.pad_end(slug, 11, " ")
      <> string.pad_start(int.to_string(covered), 5, " ")
      <> " of "
      <> int.to_string(problems)
      <> " NeetCode problems line-drillable",
    )
  })
}

// --- The Gleam Language Tour ------------------------------------------------

const tour_out_path = "../src/gleamdrill/content/problems/generated/embedded_tour.gleam"

/// The vendored lessons of tour.gleam.run, one card each. Unlike every other
/// emitter this one derives no signature or starter: the lesson's program is
/// the starter, verbatim, and the app grades nothing (see problem.Check
/// `graded`). Chapter and lesson directories carry their order in their
/// names (`chapter2_flow_control/lesson04_list_patterns`), so sorting the
/// names is the whole ordering. See drills/tour/UPSTREAM for provenance.
fn generate_tour() {
  let assert Ok(chapters) = simplifile.read_directory("tour")
  let lessons =
    chapters
    |> list.filter(string.starts_with(_, "chapter"))
    |> list.sort(string.compare)
    |> list.flat_map(fn(chapter) {
      let assert Ok(entries) = simplifile.read_directory("tour/" <> chapter)
      entries
      |> list.filter(string.starts_with(_, "lesson"))
      |> list.sort(string.compare)
      |> list.map(fn(lesson) {
        let dir = "tour/" <> chapter <> "/" <> lesson <> "/"
        let assert Ok(code) = simplifile.read(dir <> "code.gleam")
        let assert Ok(prose) = simplifile.read(dir <> "en.html")
        "  Lesson(\n    chapter: \""
        <> escape(tour_label(chapter))
        <> "\",\n    title: \""
        <> escape(tour_label(lesson))
        <> "\",\n    prose: \""
        <> escape(tour_prose(prose))
        <> "\",\n    code: \""
        <> escape(string.trim_end(code))
        <> "\",\n  ),\n"
      })
    })

  let header =
    "//// GENERATED by `gleam run -m generate` in drills/ — do not edit.\n"
    <> "//// Source of truth: drills/tour/*/*/{code.gleam,en.html}, vendored from\n"
    <> "//// gleam-lang/language-tour (Apache-2.0); see drills/tour/UPSTREAM.\n\n"
    <> "pub type Lesson {\n  Lesson(chapter: String, title: String, prose: String, code: String)\n}\n\n"
    <> "pub fn lessons() -> List(Lesson) {\n  [\n"

  let assert Ok(Nil) =
    simplifile.write(
      tour_out_path,
      header <> string.concat(lessons) <> "  ]\n}\n",
    )
  io.println(
    "embedded_tour.gleam: "
    <> int.to_string(list.length(lessons))
    <> " lessons -> "
    <> tour_out_path,
  )
}

/// "chapter2_flow_control" -> "Flow control"; "lesson04_list_patterns" ->
/// "List patterns". The tour derives its own headings the same way.
fn tour_label(name: String) -> String {
  let words = case string.split(name, "_") {
    [_prefix, ..rest] -> rest
    [] -> []
  }
  case words {
    [first, ..rest] -> string.join([string.capitalise(first), ..rest], " ")
    [] -> name
  }
}

/// The lesson HTML is shown as-is, with links opened in a new tab so a
/// reader does not lose the card underneath. Nothing else is rewritten.
fn tour_prose(html: String) -> String {
  html
  |> string.trim
  |> string.replace("<a href=", "<a target=\"_blank\" rel=\"noopener\" href=")
}
