/// haskell/verify_all.sh plus the haskell/.verify scratch tree: one
/// directory per variant holding Solution.hs, Harness.hs and Drill.hs,
/// because ghc resolves modules by file name in one directory. The api's
/// copy of the prelude is refreshed at the same time, so
/// server/priv/haskell never drifts from drills/haskell.
fn generate_haskell_verifier(rows: List(#(String, String, String))) -> Nil {
  let assert Ok(prelude) = simplifile.read("haskell/Drill.hs")
  let assert Ok(Nil) = simplifile.create_directory_all("../server/priv/haskell")
  let assert Ok(Nil) =
    simplifile.write("../server/priv/haskell/Drill.hs", prelude)

  let _ = simplifile.delete("haskell/.verify")
  list.each(rows, fn(row) {
    let #(module, _label, stem) = row
    let directory = "haskell/.verify/" <> stem
    let assert Ok(Nil) = simplifile.create_directory_all(directory)
    let assert Ok(solution) =
      simplifile.read("haskell/solutions/" <> stem <> ".hs")
    let assert Ok(harness) =
      simplifile.read("haskell/harnesses/" <> module <> ".hs")
    let assert Ok(Nil) = simplifile.write(directory <> "/Solution.hs", solution)
    let assert Ok(Nil) = simplifile.write(directory <> "/Harness.hs", harness)
    let assert Ok(Nil) = simplifile.write(directory <> "/Drill.hs", prelude)
  })

  let table =
    rows
    |> list.map(fn(row) {
      let #(module, label, stem) = row
      module <> "|" <> label <> "|" <> stem <> "\n"
    })
    |> string.concat

  let source =
    "#!/bin/sh\n"
    <> "# GENERATED by `gleam run -m generate` in drills/ - do not edit.\n"
    <> "# Runs every Haskell solution variant against its harness:\n"
    <> "#   ./verify_all.sh     (from drills/haskell)\n"
    <> "# Each .verify/<stem> directory compiles alone; its report is the last\n"
    <> "# line, a JSON object whose error is null and whose cases all passed.\n"
    <> "cd \"$(dirname \"$0\")\" || exit 1\n"
    <> "count=0\nfailures=0\n"
    <> "while IFS='|' read -r module label stem; do\n"
    <> "  [ -z \"$stem\" ] && continue\n"
    <> "  count=$((count + 1))\n"
    <> "  report=$(cd \".verify/$stem\" && timeout -s KILL 30 sh -c 'ghc -v0 -O0 -o run.bin Harness.hs && ./run.bin' 2>&1 | tail -n 1)\n"
    <> "  [ -z \"$report\" ] && report='timed out'\n"
    <> "  case \"$report\" in\n"
    <> "    *'\"error\":null'*) ;;\n"
    <> "    *) failures=$((failures + 1)); echo \"FAIL $module [$label] $report\"; continue ;;\n"
    <> "  esac\n"
    <> "  case \"$report\" in\n"
    <> "    *'\"cases\":[]'*) failures=$((failures + 1)); echo \"FAIL $module [$label] harness produced no cases\" ;;\n"
    <> "    *'\"passed\":false'*) failures=$((failures + 1)); echo \"FAIL $module [$label] $report\" ;;\n"
    <> "  esac\n"
    <> "done <<'VARIANTS'\n"
    <> table
    <> "VARIANTS\n"
    <> "echo \"$count Haskell variants checked, $failures failures\"\n"
    <> "[ \"$failures\" -eq 0 ]\n"

  let assert Ok(Nil) = simplifile.write("haskell/verify_all.sh", source)
  let assert Ok(Nil) =
    simplifile.set_permissions_octal("haskell/verify_all.sh", 0o755)
  io.println(
    "verify_all.sh: " <> int.to_string(list.length(rows)) <> " Haskell variants",
  )
}

/// Ruby drills run on the server like Go and Haskell (server/priv/run-ruby)
/// and in the terminal app with the local `ruby`. Both use one runner,
/// ruby/run.rb: it loads solution.rb, then the harness, and prints the
/// report. The generator copies it to server/priv/ruby/ and emits it as
/// `embedded_ruby.runner` for the terminal app, so the three never drift.
fn generate_ruby() {
  let assert Ok(entries) = simplifile.read_directory("ruby/harnesses")
  let assert Ok(sources) = simplifile.read_directory("ruby/solutions")
  let assert Ok(runner) = simplifile.read("ruby/run.rb")
  let modules = module_names(entries, ".rb")

  let header =
    "//// GENERATED by `gleam run -m generate` in drills/ — do not edit.\n"
    <> "//// Source of truth: drills/ruby/solutions/*.rb, drills/ruby/harnesses/*.rb and drills/ruby/run.rb.\n\n"
    <> "import gleamdrill/content/problem.{Check}\n"
    <> "import gleamdrill/content/problems/generated/embedded.{type Embedded, Embedded}\n\n"
    <> "/// drills/ruby/run.rb: loads solution.rb, then harness.rb, from the\n"
    <> "/// directory it is given and prints the report as the last line.\n"
    <> "pub const runner = \""
    <> escape(runner)
    <> "\"\n"

  let functions =
    list.map(modules, fn(module) {
      let sources = variant_sources(module, sources, "ruby/solutions/", ".rb")
      let assert Ok(harness) =
        simplifile.read("ruby/harnesses/" <> module <> ".rb")
      let assert Ok(primary) =
        simplifile.read("ruby/solutions/" <> module <> ".rb")
      let #(sig, stub) = ruby_surface(primary)
      drill_function(module, sources, sig, stub, string.trim_end(harness))
    })

  let assert Ok(Nil) =
    simplifile.write(
      "../src/gleamdrill/content/problems/generated/embedded_ruby.gleam",
      string.join(
        [
          header,
          ..list.append(functions, [by_stem_function(modules, "Embedded")])
        ],
        "\n",
      ),
    )
  io.println(
    "embedded_ruby.gleam: " <> int.to_string(list.length(modules)) <> " drills",
  )

  generate_ruby_verifier(runner, variant_rows(modules, sources, ".rb"))
}

/// A refactoring deck hands over code that works but reads badly
/// (<dir>/before/) to rewrite as <dir>/after/ has it. The starter is the
/// before, verbatim; the harness checks behaviour with its cases and the code
/// itself with `uses` and `avoids`. Both versions are shown as solutions, so
/// `[` and `]` still reach the original after editing. Ruby, Python and Go
/// each have one; `harness` turns a harness file into what the drill runs
/// (Python's gets the shared prelude in front).
type RefactorDeck {
  RefactorDeck(
    dir: String,
    extension: String,
    module: String,
    signature: fn(String) -> String,
    harness: fn(String) -> String,
  )
}

fn generate_ruby_refactor() {
  let deck =
    RefactorDeck(
      dir: "ruby/refactor",
      extension: ".rb",
      module: "embedded_ruby_refactor",
      signature: fn(before) { ruby_surface(before).0 },
      harness: fn(harness) { harness },
    )
  generate_ruby_refactor_verifier(deck, generate_refactor(deck))
}

fn generate_python_refactor() {
  let assert Ok(prelude) = simplifile.read("python/refactor/prelude.py")
  let deck =
    RefactorDeck(
      dir: "python/refactor",
      extension: ".py",
      module: "embedded_python_refactor",
      signature: fn(before) { python_surface(before).0 },
      harness: fn(harness) { string.trim_end(prelude) <> "\n\n\n" <> harness },
    )
  generate_python_refactor_verifier(deck, generate_refactor(deck))
}

fn generate_go_refactor() {
  let deck =
    RefactorDeck(
      dir: "go/refactor",
      extension: ".go",
      module: "embedded_go_refactor",
      signature: fn(before) { go_surface(before).0 },
      harness: fn(harness) { harness },
    )
  generate_go_refactor_verifier(deck, generate_refactor(deck))
}

/// Writes the deck's embedded module and returns its stems.
fn generate_refactor(deck: RefactorDeck) -> List(String) {
  let assert Ok(entries) = simplifile.read_directory(deck.dir <> "/harnesses")
  let stems = module_names(entries, deck.extension)

  let header =
    "//// GENERATED by `gleam run -m generate` in drills/ — do not edit.\n"
    <> "//// Source of truth: drills/"
    <> deck.dir
    <> "/{before,after,harnesses,prompts}/.\n\n"
    <> "import gleamdrill/content/problem.{Check}\n"
    <> "import gleamdrill/content/problems/generated/embedded.{type Embedded, Embedded}\n"

  let functions =
    list.map(stems, fn(stem) {
      let #(before, after, harness) = refactor_sources(deck, stem)
      let meta = note_meta(stem, deck.extension)
      let sources = [
        #(
          "Before",
          "",
          "The starter as handed over: it works, and the style checks fail on it.",
          before,
        ),
        #("After", meta.complexity, meta.note, after),
      ]
      drill_function(
        stem,
        sources,
        deck.signature(before),
        before,
        deck.harness(harness),
      )
    })

  let assert Ok(Nil) =
    simplifile.write(
      "../src/gleamdrill/content/problems/generated/" <> deck.module <> ".gleam",
      string.join(
        [
          header,
          ..list.append(functions, [
            by_stem_function(stems, "Embedded"),
            drills_function(deck.dir <> "/prompts", stems),
          ])
        ],
        "\n",
      ),
    )
  io.println(
    deck.module <> ".gleam: " <> int.to_string(list.length(stems)) <> " drills",
  )
  stems
}

/// `drills()`: every drill as (section, title, prompt, Embedded), in stem
/// order, from <prompts_dir>/<stem>.txt (a `section:` line, a `title:` line,
/// then the prompt). A title names a card, so two drills may never share one.
fn drills_function(prompts_dir: String, stems: List(String)) -> String {
  let rows =
    list.map(stems, fn(stem) {
      let #(section, title, prompt) = sectioned_prompt(prompts_dir, stem)
      #(stem, section, title, prompt)
    })
  let titles = list.map(rows, fn(row) { row.2 })
  case list.length(list.unique(titles)) == list.length(titles) {
    True -> Nil
    False -> panic as { "two drills in " <> prompts_dir <> " share a title" }
  }
  let entries =
    rows
    |> list.map(fn(row) {
      let #(stem, section, title, prompt) = row
      "    #(\""
      <> escape(section)
      <> "\", \""
      <> escape(title)
      <> "\", \""
      <> escape(prompt)
      <> "\", "
      <> stem
      <> "()),\n"
    })
    |> string.concat
  "pub fn drills() -> List(#(String, String, String, Embedded)) {\n  [\n"
  <> entries
  <> "  ]\n}\n"
}

fn sectioned_prompt(
  prompts: String,
  stem: String,
) -> #(String, String, String) {
  let path = prompts <> "/" <> stem <> ".txt"
  let assert Ok(text) = simplifile.read(path)
  case string.split(string.trim(text), "\n") {
    ["section: " <> section, "title: " <> title, ..prompt] if prompt != [] -> #(
      string.trim(section),
      string.trim(title),
      string.trim(string.join(prompt, "\n")),
    )
    _ -> panic as { path <> ": want section:, title:, then the prompt" }
  }
}

fn refactor_sources(
  deck: RefactorDeck,
  stem: String,
) -> #(String, String, String) {
  let read = fn(side) {
    let path = deck.dir <> "/" <> side <> "/" <> stem <> deck.extension
    let assert Ok(code) = simplifile.read(path)
    string.trim_end(code)
  }
  #(read("before"), read("after"), read("harnesses"))
}

/// The verdict every refactoring verifier applies to one run's report: the
/// after passes every case; the before passes every behaviour case and fails
/// at least one `style:` case, so the drill's checks are what tell the two
/// apart. Python source, shared by the Python and Go verifiers.
const refactor_verdict = "def verdict(side, cases):
    style = [c for c in cases if c[0].startswith(\"style:\")]
    plain = [c for c in cases if not c[0].startswith(\"style:\")]
    if not cases:
        return \"harness produced no cases\"
    if side == \"after\":
        bad = [c[0] for c in cases if not c[1]]
        return \"failed %s\" % bad if bad else None
    bad = [c[0] for c in plain if not c[1]]
    if bad:
        return \"before fails behaviour %s\" % bad
    if all(c[1] for c in style):
        return \"before passes every style case\"
    return None
"

/// python/refactor/verify_all.py: runs each drill's before and after under
/// CPython the way the browser does (one namespace, `__source__` set, the
/// prelude in front of the harness).
fn generate_python_refactor_verifier(
  _deck: RefactorDeck,
  stems: List(String),
) -> Nil {
  let table =
    stems
    |> list.map(fn(stem) { "    \"" <> stem <> "\",\n" })
    |> string.concat
  let source =
    "# GENERATED by `gleam run -m generate` in drills/ - do not edit.\n"
    <> "# Checks every Python refactoring drill:   python3 verify_all.py [STEM...]\n"
    <> "# The after must pass every case. The before must pass every behaviour\n"
    <> "# case and fail at least one style case.\n"
    <> "import contextlib\nimport io\nimport os\nimport sys\n\n"
    <> "STEMS = [\n"
    <> table
    <> "]\n\n"
    <> refactor_verdict
    <> "\n\n"
    <> "def read(root, *parts):\n"
    <> "    with open(os.path.join(root, *parts)) as handle:\n"
    <> "        return handle.read()\n\n\n"
    <> "def check(root, prelude, stem, side):\n"
    <> "    solution = read(root, side, stem + \".py\")\n"
    <> "    harness = prelude + \"\\n\\n\\n\" + read(root, \"harnesses\", stem + \".py\")\n"
    <> "    namespace = {\"__name__\": \"solution\"}\n"
    <> "    try:\n"
    <> "        with contextlib.redirect_stdout(io.StringIO()):\n"
    <> "            exec(compile(solution, \"solution.py\", \"exec\"), namespace)\n"
    <> "            namespace[\"__source__\"] = solution\n"
    <> "            exec(compile(harness, \"harness.py\", \"exec\"), namespace)\n"
    <> "    except Exception as error:\n"
    <> "        return \"raised %s: %s\" % (type(error).__name__, error)\n"
    <> "    cases = [(label, expected == actual) for label, expected, actual in namespace.get(\"__results__\", [])]\n"
    <> "    return verdict(side, cases)\n\n\n"
    <> "def main():\n"
    <> "    root = os.path.dirname(os.path.abspath(__file__))\n"
    <> "    prelude = read(root, \"prelude.py\").rstrip()\n"
    <> "    stems = sys.argv[1:] or STEMS\n"
    <> "    failures = 0\n"
    <> "    for stem in stems:\n"
    <> "        for side in (\"before\", \"after\"):\n"
    <> "            why = check(root, prelude, stem, side)\n"
    <> "            if why:\n"
    <> "                failures += 1\n"
    <> "                print(\"FAIL %s [%s] %s\" % (stem, side, why))\n"
    <> "    print(\"%d Python refactoring drills checked, %d failures\" % (len(stems), failures))\n"
    <> "    sys.exit(1 if failures else 0)\n\n\n"
    <> "main()\n"
  let assert Ok(Nil) = simplifile.write("python/refactor/verify_all.py", source)
  Nil
}

/// go/refactor/verify_all.py: stages each drill's before and after as the
/// server stages an attempt (solution.go, harness.go, prelude.go, go.mod in
/// .verify/<stem>__<side>/, straight from the sources, so it needs no
/// regenerate), runs them eight at a time and applies the verdict.
fn generate_go_refactor_verifier(
  _deck: RefactorDeck,
  stems: List(String),
) -> Nil {
  let table =
    stems
    |> list.map(fn(stem) { "    \"" <> stem <> "\",\n" })
    |> string.concat
  let source =
    "# GENERATED by `gleam run -m generate` in drills/ - do not edit.\n"
    <> "# Checks every Go refactoring drill:   python3 verify_all.py [STEM...]\n"
    <> "# Stages .verify/<stem>__<side>/ from the sources and runs it with `go run .`.\n"
    <> "# The after must pass every case. The before must pass every behaviour\n"
    <> "# case and fail at least one style case.\n"
    <> "import json\nimport os\nimport subprocess\nimport sys\n"
    <> "from concurrent.futures import ThreadPoolExecutor\n\n"
    <> "STEMS = [\n"
    <> table
    <> "]\n\n"
    <> "ENV = dict(os.environ, GOFLAGS=\"-mod=mod\", GOTOOLCHAIN=\"local\", CGO_ENABLED=\"0\", GOPROXY=\"off\")\n\n"
    <> refactor_verdict
    <> "\n\n"
    <> "def stage(root, stem, side):\n"
    <> "    directory = os.path.join(root, \".verify\", stem + \"__\" + side)\n"
    <> "    os.makedirs(directory, exist_ok=True)\n"
    <> "    sources = {\n"
    <> "        \"solution.go\": os.path.join(root, side, stem + \".go\"),\n"
    <> "        \"harness.go\": os.path.join(root, \"harnesses\", stem + \".go\"),\n"
    <> "        \"prelude.go\": os.path.join(root, \"..\", \"prelude.go\"),\n"
    <> "    }\n"
    <> "    for name, path in sources.items():\n"
    <> "        with open(path) as source, open(os.path.join(directory, name), \"w\") as target:\n"
    <> "            target.write(source.read().rstrip() + \"\\n\")\n"
    <> "    with open(os.path.join(directory, \"go.mod\"), \"w\") as target:\n"
    <> "        target.write(\"module drill\\n\\ngo 1.21\\n\")\n"
    <> "    return directory\n\n\n"
    <> "def check(root, stem, side):\n"
    <> "    try:\n"
    <> "        directory = stage(root, stem, side)\n"
    <> "    except OSError as error:\n"
    <> "        return \"missing source: %s\" % error\n"
    <> "    try:\n"
    <> "        done = subprocess.run([\"go\", \"run\", \".\"], cwd=directory, env=ENV, capture_output=True, text=True, timeout=60)\n"
    <> "    except subprocess.TimeoutExpired:\n"
    <> "        return \"timed out\"\n"
    <> "    lines = (done.stdout or \"\").strip().splitlines()\n"
    <> "    try:\n"
    <> "        report = json.loads(lines[-1])\n"
    <> "    except (IndexError, ValueError):\n"
    <> "        return (done.stderr or done.stdout).strip()[-400:]\n"
    <> "    if report.get(\"error\"):\n"
    <> "        return \"error %s\" % report[\"error\"]\n"
    <> "    cases = [(c[\"label\"], c[\"passed\"]) for c in report.get(\"cases\") or []]\n"
    <> "    return verdict(side, cases)\n\n\n"
    <> "def main():\n"
    <> "    root = os.path.dirname(os.path.abspath(__file__))\n"
    <> "    stems = sys.argv[1:] or STEMS\n"
    <> "    jobs = [(stem, side) for stem in stems for side in (\"before\", \"after\")]\n"
    <> "    with ThreadPoolExecutor(8) as pool:\n"
    <> "        results = list(pool.map(lambda job: check(root, *job), jobs))\n"
    <> "    failures = 0\n"
    <> "    for (stem, side), why in zip(jobs, results):\n"
    <> "        if why:\n"
    <> "            failures += 1\n"
    <> "            print(\"FAIL %s [%s] %s\" % (stem, side, why))\n"
    <> "    print(\"%d Go refactoring drills checked, %d failures\" % (len(stems), failures))\n"
    <> "    sys.exit(1 if failures else 0)\n\n\n"
    <> "main()\n"
  let assert Ok(Nil) = simplifile.write("go/refactor/verify_all.py", source)
  Nil
}

fn generate_ruby_refactor_verifier(
  deck: RefactorDeck,
  stems: List(String),
) -> Nil {
  let assert Ok(runner) = simplifile.read("ruby/run.rb")
  let _ = simplifile.delete("ruby/refactor/.verify")
  list.each(stems, fn(stem) {
    let #(before, after, harness) = refactor_sources(deck, stem)
    list.each([#("before", before), #("after", after)], fn(side) {
      let directory = "ruby/refactor/.verify/" <> stem <> "__" <> side.0
      let assert Ok(Nil) = simplifile.create_directory_all(directory)
      let assert Ok(Nil) =
        simplifile.write(directory <> "/solution.rb", side.1 <> "\n")
      let assert Ok(Nil) =
        simplifile.write(directory <> "/harness.rb", harness <> "\n")
      let assert Ok(Nil) = simplifile.write(directory <> "/run.rb", runner)
    })
  })

  let source =
    "#!/bin/sh\n"
    <> "# GENERATED by `gleam run -m generate` in drills/ - do not edit.\n"
    <> "# Checks every Ruby refactoring drill:   ./verify_all.sh   (from drills/ruby/refactor)\n"
    <> "# The after must pass every case. The before must pass every behaviour\n"
    <> "# case and fail at least one style case.\n"
    <> "cd \"$(dirname \"$0\")\" || exit 1\n"
    <> "verdict='r = JSON.parse(STDIN.read.lines.last.to_s) rescue nil\n"
    <> "exit 2 unless r && r[\"error\"].nil? && r[\"cases\"].any?\n"
    <> "style, plain = r[\"cases\"].partition { |c| c[\"label\"].start_with?(\"style:\") }\n"
    <> "ok = ARGV[0] == \"after\" ? r[\"cases\"].all? { |c| c[\"passed\"] } : plain.all? { |c| c[\"passed\"] } && style.any? { |c| !c[\"passed\"] }\n"
    <> "puts r[\"cases\"].reject { |c| c[\"passed\"] }.map { |c| c[\"label\"] }.inspect unless ok\n"
    <> "exit(ok ? 0 : 1)'\n"
    <> "count=0\nfailures=0\n"
    <> "while read -r stem; do\n"
    <> "  [ -z \"$stem\" ] && continue\n"
    <> "  count=$((count + 1))\n"
    <> "  for side in before after; do\n"
    <> "    report=$(timeout -s KILL 10 ruby --disable-gems \".verify/${stem}__$side/run.rb\" \".verify/${stem}__$side\" 2>&1)\n"
    <> "    if ! why=$(printf '%s\\n' \"$report\" | ruby --disable-gems -rjson -e \"$verdict\" \"$side\"); then\n"
    <> "      failures=$((failures + 1)); echo \"FAIL $stem [$side] $why $(printf '%s' \"$report\" | tail -n 1 | cut -c1-300)\"\n"
    <> "    fi\n"
    <> "  done\n"
    <> "done <<'STEMS'\n"
    <> string.join(stems, "\n")
    <> "\nSTEMS\n"
    <> "echo \"$count Ruby refactoring drills checked, $failures failures\"\n"
    <> "[ \"$failures\" -eq 0 ]\n"

  let assert Ok(Nil) = simplifile.write("ruby/refactor/verify_all.sh", source)
  let assert Ok(Nil) =
    simplifile.set_permissions_octal("ruby/refactor/verify_all.sh", 0o755)
  Nil
}

