# Copy to .env and adjust. `.env` is gitignored -- never commit real secrets.
DATABASE_URL=postgres://charlesg@127.0.0.1:5432/algodrill_dev
# Generate with: openssl rand -base64 64 | tr -d '\n'
SECRET_KEY_BASE=replace-me-with-64-or-more-random-characters-xxxxxxxxxxxxxxxxxxxx
# The exact origin(s) the browser app is served from, comma-separated.
# Locally: :1234 is `make dev`, :4173 is the test file-server (make serve-dist).
ALLOWED_ORIGIN=http://localhost:1234,http://localhost:4173
# Defaults: 127.0.0.1:1637. Containers set PORT=8080 and BIND=0.0.0.0
# (server/Dockerfile). On Railway use BIND=:: instead -- the private
# network there is IPv6-only, so 0.0.0.0 never sees the proxy's traffic.
#PORT=1637
#BIND=127.0.0.1
SESSION_DAYS=30
