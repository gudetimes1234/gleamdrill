fn path(tree: Tree, target: Int, seen: List(Int)) -> List(Int) {
  case tree {
    Leaf -> []
    Node(value, left, right) ->
      case value == target {
        True -> [value, ..seen]
        False ->
          case path(left, target, [value, ..seen]) {
