pub fn max_profit(prices: List(Int)) -> Int {
  let lookup = prices |> list.index_map(fn(p, i) { #(i, p) }) |> dict.from_list
  let #(best, _) = from(0, list.length(prices), False, lookup, dict.new())
  best
