fn search(nums: List(Int), low: Int, high: Int) -> Int {
  case low >= high {
    True -> low
    False -> {
      let middle = { low + high } / 2
      let seen = list.count(nums, fn(value) { value <= middle })
      case seen > middle {
        True -> search(nums, low, middle)
        False -> search(nums, middle + 1, high)
      }
    }
  }
