        "import gleam/list
import gleam/set.{type Set}
import gleam/string

pub fn ladder_length(
  begin_word: String,
  end_word: String,
  word_list: List(String),
) -> Int {
  let words = set.from_list(word_list)

  case set.contains(words, end_word) {
