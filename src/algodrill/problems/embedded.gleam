            land,
            list.append(rest, neighbours(at)),
            set.insert(seen, at),
            area + 1,
          )
      }
  }
}

fn neighbours(at: #(Int, Int)) -> List(#(Int, Int)) {
  let #(r, c) = at
  [#(r - 1, c), #(r + 1, c), #(r, c - 1), #(r, c + 1)]
