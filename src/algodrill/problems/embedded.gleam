import gleam/string

pub fn word_frequencies(text: String) -> dict.Dict(String, Int) {
  text
  |> string.lowercase
  |> string.split(\" \")
  |> list.filter(fn(word) { word != \"\" })
  |> list.sort(string.compare)
  |> runs([])
  |> dict.from_list
