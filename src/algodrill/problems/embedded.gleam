import gleam/int
import gleam/list
import gleam/result
import gleam/set.{type Set}

pub fn clone_graph(adjacency: List(List(Int)), start: Int) -> List(List(Int)) {
  let graph =
    dict.from_list(list.index_map(adjacency, fn(edges, i) { #(i, edges) }))

