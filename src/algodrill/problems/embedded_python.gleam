    # answer, so every query leaves the pool the moment it is settled and the
    # pool only ever shrinks.
    answers = [-1] * len(queries)
    waiting = list(enumerate(queries))

    for start, end in sorted(intervals, key=lambda i: i[1] - i[0]):
