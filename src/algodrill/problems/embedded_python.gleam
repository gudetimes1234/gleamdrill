pub fn tip03_deque() -> Embedded {
  Embedded(
    solutions: [
      #("Solution 1", "", "from collections import deque

def bfsOrder(graph, start):
    queue = deque([start])
    seen = {start}
    order = []
    while queue:
        node = queue.popleft()
        order.append(node)
        for neighbor in graph.get(node, []):
            if neighbor not in seen:
                seen.add(neighbor)
                queue.append(neighbor)
    return order"),
      #("Solution 2 · List queue", "A list plus a read cursor. The cursor is the point: list.pop(0) is O(n), so a plain list only stays a good queue if you never shift it.", "def bfsOrder(graph, start):
    queue = [start]
    head = 0
    seen = {start}
    order = []

    while head < len(queue):
        node = queue[head]
        head += 1
        order.append(node)
        for neighbor in graph.get(node, []):
            if neighbor not in seen:
                seen.add(neighbor)
                queue.append(neighbor)

    return order"),
    ],
    check: Check(
      signature: "def bfsOrder(graph, start):",
      starter: "def bfsOrder(graph, start):
    pass",
      harness: "try:
    (bfsOrder)
except NameError:
    raise Exception(\"__signature_mismatch__\")

__results__ = []
def __case__(label, expected, actual):
    __results__.append([label, repr(expected), repr(actual)])

__graph__ = {\"a\": [\"b\", \"c\"], \"b\": [\"d\"], \"c\": [\"d\"], \"d\": []}
__case__(\"bfsOrder(graph, 'a')\", [\"a\", \"b\", \"c\", \"d\"], bfsOrder(__graph__, \"a\"))
__case__(\"bfsOrder({'x': []}, 'x')\", [\"x\"], bfsOrder({\"x\": []}, \"x\"))",
