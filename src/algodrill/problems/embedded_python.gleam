        # distance/spd > lead_distance/lead_speed, cross-multiplied so the
        # arrival times never have to become fractions.
        if distance * lead_speed > lead_distance * spd:
            fleets += 1
            lead_distance, lead_speed = distance, spd

    return fleets"),
