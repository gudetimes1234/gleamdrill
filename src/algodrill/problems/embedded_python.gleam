__case__(\"decode(encode(['', '']))\", [\"\", \"\"], __round_trip__([\"\", \"\"]))
__case__(\"decode(encode(['3#x', 'a|b']))\", [\"3#x\", \"a|b\"], __round_trip__([\"3#x\", \"a|b\"]))
