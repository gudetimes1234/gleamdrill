    [\"findWords([['a','b'],['c','d']], ['abcb'])\", show([]), show(sorted([[\"a\", \"b\"], [\"c\", \"d\"]], [\"abcb\"]))],
    [\"findWords([['a']], ['a'])\", show([\"a\"]), show(sorted([[\"a\"]], [\"a\"]))],
