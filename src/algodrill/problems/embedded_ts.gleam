  while (i < s.length) {
    const hashAt = s.indexOf(\"#\", i);
    const length = Number(s.slice(i, hashAt));
    const start = hashAt + 1;
    out.push(s.slice(start, start + length));
    i = start + length;
  }
  return out;
}"),
