  const out: number[] = [];
  let carry = 0;
  for (let i = number.length - 1; i >= 0; i--) {
    const product = Number(number[i]) * digit + carry;
    out.push(product % 10);
    carry = Math.floor(product / 10);
  }
  if (carry) out.push(carry);
  return out.reverse().join(\"\").replace(/^0+/, \"\") || \"0\";
