def flatten_tree(node, tokens)
  if node.nil?
    tokens << nil
    return
  end
  tokens << node.val
  flatten_tree(node.left, tokens)
  flatten_tree(node.right, tokens)
end

def rebuild(tokens)
  value = tokens.next
  return nil if value.nil?

  first = rebuild(tokens)
  second = rebuild(tokens)
  TreeNode.new(value, second, first)
end",
