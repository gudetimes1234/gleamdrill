    unlink(@nodes.delete(key)) if @nodes.key?(key)
    node = { key: key, value: value, prev: nil, next: nil }
    @nodes[key] = node
    push(node)
    return unless @nodes.size > @capacity

    oldest = @tail[:prev]
    unlink(oldest)
    @nodes.delete(oldest[:key])
  end

