tc 'is_match(\"aa\", \"a*\")', true, is_match(\"aa\", \"a*\")
tc 'is_match(\"ab\", \".*\")', true, is_match(\"ab\", \".*\")
tc 'is_match(\"aab\", \"c*a*b\")', true, is_match(\"aab\", \"c*a*b\")
