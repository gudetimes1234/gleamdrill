func characterReplacement(s string, k int) int {
	counts := [26]int{}
	start, mostFrequent, best := 0, 0, 0
	for end := 0; end < len(s); end++ {
		counts[s[end]-'A']++
		if counts[s[end]-'A'] > mostFrequent {
