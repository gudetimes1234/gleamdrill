			tc(\"combinationSum([2,3,5], 8)\", [][]int{{2, 2, 2, 2}, {2, 3, 3}, {3, 5}}, sortRows(combinationSum([]int{2, 3, 5}, 8))),
			tc(\"combinationSum([2], 1)\", [][]int{}, sortRows(combinationSum([]int{2}, 1))),
