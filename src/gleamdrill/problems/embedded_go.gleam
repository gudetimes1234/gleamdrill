			tc(\"myPow(2.0, 0)\", 1.0, myPow(2.0, 0)),
			tc(\"myPow(0.5, 3)\", 0.125, myPow(0.5, 3)),
			tc(\"myPow(-2.0, 3)\", -8.0, myPow(-2.0, 3)),
