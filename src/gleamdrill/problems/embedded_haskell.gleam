import Data.Array

-- table (i, j): LCS of the suffixes text1[i:] and text2[j:], memoised in
-- a lazy array. Matching characters extend the diagonal; otherwise take
-- the better of dropping one.
longestCommonSubsequence :: String -> String -> Int
