            , not (Set.member c cols)
            , not (Set.member (r - c) diagonals)
            , not (Set.member (r + c) antiDiagonals)
            ]
    render queens = [replicate c '.' ++ \"Q\" ++ replicate (n - c - 1) '.' | c <- queens]",
