<div class="queue-screen">



  <header class="queue-header">
    <h1 class="queue-title">
      Study queue
    </h1>
    <span class="queue-total">
      2 in queue
    </span>
    <button class="btn-primary queue-study-now">
      Study now · 1
    </button>
    <nav aria-label="Screens" class="study-account">
      <span class="nav-track">
        Python
      </span>
      <a class="link-button nav-link" href="/tracks">
        Tracks
      </a>
      <a class="link-button nav-link" href="/t/neetcode-150/study">
        Study
      </a>
      <span aria-current="page" class="nav-link nav-current">
        Queue
      </span>
      <a class="link-button nav-link" href="/t/neetcode-150/stats">
        Stats
      </a>
      <a class="link-button nav-link" href="/tour">
        Tour
      </a>
      <a class="link-button nav-link" href="/settings">
        Settings
      </a>
      <span class="nav-gap"></span>
      <span class="study-email">
        drills@example.com
      </span>
      <button class="link-button nav-link">
        Sign out
      </button>
    </nav>
  </header>
  <div class="queue-selector">
    <div class="queue-picker">
      <button class="queue-pick current " type="button">
        Everything
      </button>
      <button class="queue-pick queue-new" type="button">
        + New queue
      </button>
    </div>
  </div>
  <p class="queue-lede">
    Only queued problems are scheduled. Adding one puts it in line to be introduced against your daily new limit; removing one takes it out entirely.
  </p>
  <div class="queue-controls">
    <input class="search" placeholder="Search problems…" type="search" value>
    <label class="queue-control">
      <span class="queue-control-label">
        Show
      </span>
      <select class="queue-select queue-status">
        <option selected value="all">
          All
        </option>
        <option value="queued">
          In queue
        </option>
        <option value="new">
          New
        </option>
        <option value="due">
          Due
        </option>
        <option value="paused">
          Paused
        </option>
        <option value="unqueued">
          Not queued
        </option>
      </select>
    </label>
  </div>
  <div class="queue-bulk">
    <span class="queue-shown">
      150 shown
    </span>
    <button class="queue-bulk-add">
