<div class="statusbar">
  <span class="statusbar-context">
    QUEUE
  </span>
  <span class="leader-chip " title="Press , then a key to use a shortcut even while a button has focus">
    ,
  </span>
  <div class="statusbar-hints">
    <button class="keyhint" title="Move the cursor down / up">
      <span class="keyhint-keys">
        j/k
      </span>
      <span class="keyhint-label">
        move
      </span>
    </button>
    <button class="keyhint" title="Add the cursor row to the queue, or take it out">
      <span class="keyhint-keys">
        space/x
      </span>
      <span class="keyhint-label">
        toggle
      </span>
    </button>
    <button class="keyhint" title="Add every problem currently listed">
      <span class="keyhint-keys">
        a
      </span>
      <span class="keyhint-label">
        add all
      </span>
    </button>
    <button class="keyhint" title="Remove every problem currently listed">
      <span class="keyhint-keys">
        r
      </span>
      <span class="keyhint-label">
        remove all
      </span>
    </button>
    <button class="keyhint" title="Search problems">
      <span class="keyhint-keys">
        /
      </span>
      <span class="keyhint-label">
        search
      </span>
    </button>
    <button class="keyhint" title="Jump to the first row">
      <span class="keyhint-keys">
        g
      </span>
      <span class="keyhint-label">
        top
      </span>
    </button>
    <button class="keyhint" title="Jump to the last row">
      <span class="keyhint-keys">
        G
      </span>
      <span class="keyhint-label">
        bottom
      </span>
    </button>
    <button class="keyhint" title="Back to the study screen">
      <span class="keyhint-keys">
        esc
      </span>
      <span class="keyhint-label">
        study
      </span>
    </button>
  </div>
</div>
<button aria-label="Help and keyboard shortcuts" class="help-fab">
  ?
</button>


