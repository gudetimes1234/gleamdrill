      <span class="keyhint-keys">
        j/k
      </span>
      <span class="keyhint-label">
        move
      </span>
    </button>
    <button class="keyhint" title="Open the problem&#39;s review history">
      <span class="keyhint-keys">
        ↵
      </span>
      <span class="keyhint-label">
        detail
      </span>
    </button>
    <button class="keyhint" title="Back to the study screen">
      <span class="keyhint-keys">
        esc/b
      </span>
      <span class="keyhint-label">
        back
      </span>
    </button>
    <button class="keyhint" title="This cheatsheet">
