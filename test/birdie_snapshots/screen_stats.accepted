---
version: 2.0.2
title: screen: stats
file: ./test/gleamdrill/snapshot_test.gleam
test_name: stats_screen_test
---
<div class="stats-screen">



  <header class="study-header">
    <h1 class="study-title">
      Progress
    </h1>
    <nav aria-label="Screens" class="study-account">
      <span class="nav-track">
        Python
      </span>
      <a class="link-button nav-link" href="/tracks">
        Tracks
      </a>
      <a class="link-button nav-link" href="/t/neetcode-150/study">
        Study
      </a>
      <a class="link-button nav-link" href="/t/neetcode-150/queue">
        Queue
      </a>
      <span aria-current="page" class="nav-link nav-current">
        Stats
      </span>
      <a class="link-button nav-link" href="/tour">
        Tour
      </a>
      <a class="link-button nav-link" href="/settings">
        Settings
      </a>
      <span class="nav-gap"></span>
      <span class="study-email">
        drills@example.com
      </span>
      <button class="link-button nav-link">
        Sign out
      </button>
    </nav>
  </header>
  <div class="stats-tiles">
    <div class="stats-tile stats-tile-hero">
      <span class="stats-tile-value">
        1
      </span>
      <span class="stats-tile-label">
        under 3 minutes
      </span>
      <span class="stats-tile-delta">
        ▴1 this week
      </span>
    </div>
    <div class="stats-tile">
      <span class="stats-tile-value">
        1
      </span>
      <span class="stats-tile-label">
        problems started
      </span>
    </div>
    <div class="stats-tile">
      <span class="stats-tile-value">
        1
      </span>
      <span class="stats-tile-label">
        day streak
      </span>
    </div>
    <div class="stats-tile">
      <span class="stats-tile-value">
        —
      </span>
      <span class="stats-tile-label">
        true retention
      </span>
    </div>
  </div>
  <section class="stats-section">
    <h2 class="study-section-title">
      Where your problems stand
    </h2>
    <div class="state-bars">
      <div class="state-row">
        <span class="state-label">
          Fluent · under 3m
        </span>
        <div class="state-track">
          <div class="state-fill tier-fluent" style="width:100%;"></div>
        </div>
        <span class="state-count">
          1
        </span>
      </div>
      <div class="state-row">
        <span class="state-label">
          Solid · under 8m
        </span>
        <div class="state-track">
          <div class="state-fill tier-solid" style="width:2%;"></div>
        </div>
        <span class="state-count">
          0
        </span>
      </div>
      <div class="state-row">
        <span class="state-label">
          Grinding
        </span>
        <div class="state-track">
          <div class="state-fill tier-grinding" style="width:2%;"></div>
        </div>
        <span class="state-count">
          0
        </span>
      </div>
      <div class="state-row">
        <span class="state-label">
          Still learning
        </span>
        <div class="state-track">
          <div class="state-fill tier-learning" style="width:2%;"></div>
        </div>
        <span class="state-count">
          0
        </span>
      </div>
    </div>
  </section>
  <section class="stats-section">
    <h2 class="study-section-title">
      When you press… does it stick?
    </h2>
    <div class="state-bars">
      <div class="state-row">
        <span class="state-label grade-name-good">
          Good
        </span>
        <div class="state-track">
          <div class="state-fill tier-fluent" style="width:50%;"></div>
        </div>
        <span class="state-count">
          50% of 2
        </span>
      </div>
    </div>
    <p class="calibration-verdict quiet">
      Too few repeat reviews to judge your grading yet.
    </p>

  </section>

  <section class="stats-section">
    <h2 class="study-section-title">
      Recently mastered
    </h2>
    <div class="problem-rows">
      <button class="problem-row cursor " id="stat-0">
        <span class="problem-row-title">
          Contains Duplicate
        </span>
        <span class="lang-tag">
          py
        </span>
        <span class="difficulty difficulty-easy">
          Easy
        </span>
        <span class="problem-row-time">
          2m30s
        </span>
        <span class="trend trend-down">
          ↘
        </span>
        <span class="problem-row-due">
          due 10m
        </span>
      </button>
    </div>
  </section>

  <section class="stats-section">
    <h2 class="study-section-title">
      Where your cards are
    </h2>
    <div class="state-bars">
      <div class="state-row">
        <span class="state-label">
          Learning
        </span>
        <div class="state-track">
          <div class="state-fill state-fill-1" style="width:100%;"></div>
        </div>
        <span class="state-count">
          2
        </span>
      </div>
      <div class="state-row">
        <span class="state-label">
          Review
        </span>
        <div class="state-track">
          <div class="state-fill state-fill-2" style="width:0%;"></div>
        </div>
        <span class="state-count">
          0
        </span>
      </div>
      <div class="state-row">
        <span class="state-label">
          Relearning
        </span>
        <div class="state-track">
          <div class="state-fill state-fill-3" style="width:0%;"></div>
        </div>
        <span class="state-count">
          0
        </span>
      </div>
    </div>
  </section>
