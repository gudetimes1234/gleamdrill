---
version: 2.0.2
title: screen: tracks
file: ./test/gleamdrill/snapshot_test.gleam
test_name: tracks_screen_test
---
<div class="tracks-screen">



  <header class="study-header">
    <h1 class="study-title">
      <img alt aria-hidden="true" class="brand-mark" height="32" src="/favicon.svg" width="32">
      GleamDrill
    </h1>
    <nav aria-label="Screens" class="study-account">
      <span class="nav-track">
        Python
      </span>
      <span aria-current="page" class="nav-link nav-current">
        Tracks
      </span>
      <a class="link-button nav-link" href="/t/neetcode-150/study">
        Study
      </a>
      <a class="link-button nav-link" href="/t/neetcode-150/queue">
        Queue
      </a>
      <a class="link-button nav-link" href="/t/neetcode-150/stats">
        Stats
      </a>
      <a class="link-button nav-link" href="/tour">
        Tour
      </a>
      <a class="link-button nav-link" href="/settings">
        Settings
      </a>
      <span class="nav-gap"></span>
      <span class="study-email">
        drills@example.com
      </span>
      <button class="link-button nav-link">
        Sign out
      </button>
    </nav>
  </header>
  <p class="tracks-lead">
    One track at a time. Switching loses nothing: each keeps its own queue, its own limits and its own history.
  </p>
  <div class="track-cards">
    <div class="track-card current ">
      <button class="link-button track-card-open" type="button">
        <span class="track-card-name">
          Python
        </span>
        <span class="track-card-tag">
          py
        </span>
      </button>
      <div class="track-card-counts">
        <div class="track-count">
          <span class="track-count-value">
            0
          </span>
          <span class="track-count-label">
            Due
          </span>
        </div>
        <div class="track-count">
          <span class="track-count-value">
            4
          </span>
          <span class="track-count-label">
            New
          </span>
        </div>
        <div class="track-count">
          <span class="track-count-value">
            2
          </span>
          <span class="track-count-label">
            Cards
          </span>
        </div>
      </div>
      <p class="track-card-done">
        1 done today
      </p>
    </div>
    <div class="track-card ">
      <button class="link-button track-card-open" type="button">
        <span class="track-card-name">
          Gleam
        </span>
        <span class="track-card-tag">
          gl
        </span>
      </button>
      <p class="track-card-empty">
        Nothing queued yet.
      </p>
      <button class="btn-secondary track-card-starter" type="button">
        Start with twenty easy ones
      </button>
    </div>
    <div class="track-card ">
      <button class="link-button track-card-open" type="button">
        <span class="track-card-name">
          TypeScript
        </span>
        <span class="track-card-tag">
          ts
        </span>
      </button>
      <p class="track-card-empty">
        Nothing queued yet.
      </p>
      <button class="btn-secondary track-card-starter" type="button">
        Start with twenty easy ones
      </button>
    </div>
    <div class="track-card ">
      <button class="link-button track-card-open" type="button">
        <span class="track-card-name">
          Elixir
        </span>
        <span class="track-card-tag">
          ex
        </span>
      </button>
      <p class="track-card-empty">
        Nothing queued yet.
      </p>
      <button class="btn-secondary track-card-starter" type="button">
        Start with twenty easy ones
      </button>
    </div>
    <div class="track-card ">
      <button class="link-button track-card-open" type="button">
        <span class="track-card-name">
          Go
        </span>
        <span class="track-card-tag">
          go
        </span>
      </button>
      <p class="track-card-empty">
        Nothing queued yet.
      </p>
      <button class="btn-secondary track-card-starter" type="button">
        Start with twenty easy ones
      </button>
    </div>
    <div class="track-card ">
      <button class="link-button track-card-open" type="button">
        <span class="track-card-name">
          Haskell
        </span>
        <span class="track-card-tag">
          hs
        </span>
      </button>
      <p class="track-card-empty">
        Nothing queued yet.
      </p>
      <button class="btn-secondary track-card-starter" type="button">
        Start with twenty easy ones
      </button>
    </div>
    <div class="track-card ">
      <button class="link-button track-card-open" type="button">
        <span class="track-card-name">
          System Design
        </span>
        <span class="track-card-tag">
          sd
        </span>
      </button>
      <p class="track-card-empty">
        Nothing queued yet.
      </p>
      <button class="btn-secondary track-card-starter" type="button">
        Start with twenty easy ones
      </button>
    </div>
    <div class="track-card ">
      <button class="link-button track-card-open" type="button">
        <span class="track-card-name">
          System Design Board
        </span>
        <span class="track-card-tag">
          bd
        </span>
      </button>
      <p class="track-card-empty">
        Nothing queued yet.
      </p>
      <button class="btn-secondary track-card-starter" type="button">
        Start with twenty easy ones
      </button>
    </div>
  </div>
</div>
<div class="statusbar">
  <button class="statusbar-session" title="Choose a track (C-b s)">
    [neetcode-150]
  </button>
  <div class="statusbar-windows">
    <button class="status-window " title="C-b 0">
      0:study-
    </button>
    <button class="status-window " title="C-b 1">
      1:browse
    </button>
    <button class="status-window " title="C-b 2">
      2:queue
    </button>
    <button class="status-window " title="C-b 3">
      3:stats
    </button>
    <button class="status-window " title="C-b 4">
      4:tour
    </button>
    <button class="status-window " title="C-b 5">
      5:settings
    </button>
  </div>
  <span class="statusbar-context">
    TRACKS
  </span>
  <span class="leader-chip " title="C-b then a key runs a tmux command; , then a key uses a shortcut even while a button has focus">
    C-b
  </span>
  <div class="statusbar-hints">
    <button class="keyhint" title="Back to study">
      <span class="keyhint-keys">
        esc/b
      </span>
      <span class="keyhint-label">
        back
      </span>
    </button>
    <button class="keyhint" title="This cheatsheet">
      <span class="keyhint-keys">
        ?
      </span>
      <span class="keyhint-label">
        keys
      </span>
    </button>
  </div>
</div>
<button aria-label="Help and keyboard shortcuts" class="help-fab">
  ?
</button>

<div aria-label="Loading from the server" class="sync-bar" role="progressbar"></div>

